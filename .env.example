# Environment Variables for VibeTrader
# Copy this file to .env and update with your actual values

# Data Paths
# VIBE_PATH should point to the root directory containing your Vibe data
# The catalog will be automatically located at VIBE_PATH/catalog
VIBE_PATH=/path/to/vibe/data

# Optional base URL for large test fixtures, without a trailing slash.
# Leave unset for offline development; large-fixture helpers fail closed.
VIBE_TEST_DATA_BASE_URL=
