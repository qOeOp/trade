{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.live-small-result.v1",
  "title": "trade-flow live-small result",
  "description": "Stable outer shape for one live-small execution attempt. Exchange-specific execution_result internals remain owned by the execution tool response contract.",
  "type": "object",
  "required": ["mode", "preflight_result", "execution_gate", "recorded"],
  "properties": {
    "mode": {
      "enum": ["live-small"]
    },
    "preflight_result": {
      "type": "object"
    },
    "execution_gate": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["ready", "skipped"]
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "execution_contract": {
      "type": "object"
    },
    "execution_result": {
      "type": "object"
    },
    "observe_event": {
      "$ref": "observe-event.schema.json"
    },
    "order_fill_event": {
      "$ref": "plan-event.schema.json"
    },
    "latest_order_fill": {
      "type": ["object", "null"]
    },
    "recorded": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
