{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.program-shadow-wakeup-result.v1",
  "title": "trade-flow program wakeup result",
  "description": "Stable profile, safety, and lease outcome for one program-owned wakeup. Job graph detail remains owner-defined.",
  "type": "object",
  "required": [
    "schema_version",
    "runtime_profile",
    "cycle_id",
    "outcome",
    "business_status",
    "reason",
    "safety",
    "lease"
  ],
  "properties": {
    "schema_version": { "const": "trade-flow.program-shadow-wakeup-result.v1" },
    "runtime_profile": { "enum": ["shadow_program", "catalog_hygiene_canary", "full_shadow"] },
    "cycle_id": { "type": "string", "minLength": 1 },
    "outcome": {
      "enum": ["executed", "recovered_running", "skipped_lock", "skipped_terminal", "ops_store_busy"]
    },
    "business_status": { "enum": ["completed", "failed", "blocked", "skipped"] },
    "reason": { "type": "string", "minLength": 1 },
    "safety": {
      "type": "object",
      "required": [
        "domain_jobs_enabled",
        "enabled_domain_jobs",
        "allowed_domain_writes",
        "live_writes_allowed",
        "notify_dry_run",
        "l2_owner_health_required",
        "l2_consumer_health_required"
      ],
      "properties": {
        "domain_jobs_enabled": { "type": "boolean" },
        "enabled_domain_jobs": {
          "type": "array",
          "items": { "enum": ["account_reconcile_guard", "fast_track_guard", "slow_track_market_watch", "rd_strategy_supervisor", "rd_forward_shadow_trackers", "catalog_hygiene_scan", "closed_flow_review_sweep"] },
          "maxItems": 7,
          "uniqueItems": true
        },
        "allowed_domain_writes": {
          "type": "array",
          "items": { "enum": ["trade_event_store", "research_state_store", "artifact_catalog", "governance_ledger"] },
          "maxItems": 4,
          "uniqueItems": true
        },
        "live_writes_allowed": { "const": false },
        "notify_dry_run": { "const": true },
        "l2_owner_health_required": { "const": true },
        "l2_consumer_health_required": { "const": true }
      },
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "required": ["lock_key", "acquired", "released"],
      "properties": {
        "lock_key": { "const": "program-runtime-shadow" },
        "acquired": { "type": "boolean" },
        "released": { "type": "boolean" },
        "fencing_token": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "prior_status": { "enum": ["completed", "failed", "blocked"] },
    "ops_summary": { "type": "object" },
    "job_graph": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "runtime_profile": { "const": "shadow_program" } },
        "required": ["runtime_profile"]
      },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "domain_jobs_enabled": { "const": false },
              "enabled_domain_jobs": { "maxItems": 0 },
              "allowed_domain_writes": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "runtime_profile": { "const": "catalog_hygiene_canary" } },
        "required": ["runtime_profile"]
      },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "domain_jobs_enabled": { "const": true },
              "enabled_domain_jobs": { "minItems": 1, "maxItems": 1 },
              "allowed_domain_writes": { "minItems": 1, "maxItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "runtime_profile": { "const": "full_shadow" } },
        "required": ["runtime_profile"]
      },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "domain_jobs_enabled": { "const": true },
              "enabled_domain_jobs": { "minItems": 7, "maxItems": 7 },
              "allowed_domain_writes": { "minItems": 4, "maxItems": 4 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": { "enum": ["executed", "recovered_running"] }
        }
      },
      "then": { "required": ["job_graph"] }
    }
  ],
  "additionalProperties": false
}
