{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.flow-state-result.v1",
  "title": "trade-flow flow state result",
  "description": "Stable outer shape for a reduced local flow state. Order internals and risk diagnostics remain shallow.",
  "type": "object",
  "required": [
    "chain_id",
    "event_count",
    "latest_observe",
    "latest_order_fill",
    "current_orders",
    "current_position",
    "risk_lock",
    "open_action_gap"
  ],
  "properties": {
    "chain_id": {
      "type": "string"
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "latest_observe": {
      "type": ["object", "null"]
    },
    "latest_order_fill": {
      "type": ["object", "null"]
    },
    "current_orders": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "current_position": {
      "type": "object",
      "required": ["symbol", "position_side", "net_qty", "avg_entry_price", "state"],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "position_side": {
          "type": "string"
        },
        "net_qty": {
          "type": "number"
        },
        "avg_entry_price": {
          "type": "number"
        },
        "state": {
          "enum": ["flat", "long", "short"]
        }
      },
      "additionalProperties": false
    },
    "risk_lock": {
      "type": "object"
    },
    "open_action_gap": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
