{
  "name": "trade-flow",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "server:validate": "bun src/scripts/server-runtime.ts --action validate",
    "server:preflight": "bun src/scripts/server-runtime.ts --action preflight",
    "server:status": "bun src/scripts/server-runtime.ts --action status",
    "server:verify-lifecycle": "bun src/scripts/server-runtime-lifecycle-fixture.ts",
    "server:public-smoke": "bun src/scripts/server-runtime-public-smoke.ts",
    "server:verify-recovery": "bun src/scripts/server-runtime-recovery-fixture.ts",
    "server:release-gate": "bun src/scripts/server-runtime-release-gate.ts",
    "server:stage-release": "bun src/scripts/server-runtime-release-stage.ts",
    "server:package-container-source": "bun src/scripts/server-runtime-container-release-package.ts",
    "server:render-systemd": "bun src/scripts/server-runtime.ts --action render-systemd --profile profile/server-runtime.json",
    "server:render-launchd": "bun src/scripts/server-runtime.ts --action render-launchd --profile profile/server-runtime-macos.json",
    "server:launchd-manager": "bun src/scripts/server-runtime-launchd-manager.ts",
    "program-shadow:launchd-install": "bun src/scripts/program-shadow-launchd.ts install",
    "program-shadow:launchd-status": "bun src/scripts/program-shadow-launchd.ts status",
    "program-shadow:launchd-uninstall": "bun src/scripts/program-shadow-launchd.ts uninstall",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "test": "bun test ./src/scripts/**/*.test.ts",
    "check": "bun run lint && bun run test"
  }
}
