{
  "name": "agent-workspace-manager",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "test": "bun test ./src/lib/*.test.ts",
    "repository:packages": "bun ./src/scripts/repository-package-checks.ts",
    "repository:secrets": "bun ./src/scripts/repository-secret-scan.ts",
    "repository:side-effects": "bun ./src/lib/repository-side-effects.ts",
    "check": "bun run lint && bun run test"
  }
}
