{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.rd-replay-attempt-admission-result.v3",
  "type": "object",
  "required": ["schema_version", "status", "recovered_at", "claimed_at", "recovery", "dispatch_authority"],
  "properties": {
    "schema_version": { "const": "trade.rd-replay-attempt-admission-result.v3" },
    "status": { "const": "admitted" },
    "recovered_at": { "type": "string", "format": "date-time" },
    "claimed_at": { "type": "string", "format": "date-time" },
    "recovery": { "$ref": "replay-cancellation-recovery-job-result.schema.json" },
    "dispatch_authority": {
      "type": "object",
      "required": ["schema_version", "authority_id", "authority_ref", "authority_hash", "authority_policy_version", "status", "authority_owner", "authority_source", "issue_consistency", "binding_policy", "request_registration_id", "request_registration_hash", "request_registration", "replay_execution_request_hash", "trial_id", "run_id", "reservation_ref", "reservation_hash", "attempt_id", "attempt_ordinal", "worker_id", "attempt_status", "lease_generation", "attempt_lease_hash", "attempt_lease", "issued_at", "valid_before", "dispatch_authority", "search_authority", "review_authority", "lifecycle_authority", "economic_authority"],
      "properties": {
        "schema_version": { "const": "trade.rd-replay-registered-attempt-dispatch-authority.v1" },
        "authority_id": { "type": "string", "minLength": 1 },
        "authority_ref": { "type": "string", "minLength": 1 },
        "authority_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "authority_policy_version": { "const": "rd-replay-registered-attempt-dispatch-authority-v1" },
        "status": { "const": "registered_request_current_lease_bound" },
        "authority_owner": { "const": "research_control_plane" },
        "authority_source": { "const": "research_control_plane_state_store" },
        "issue_consistency": { "const": "single_control_plane_transaction" },
        "binding_policy": { "const": "exact_registered_request_plus_exact_current_attempt_lease" },
        "request_registration_id": { "type": "string", "minLength": 1 },
        "request_registration_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "request_registration": { "type": "object" },
        "replay_execution_request_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "trial_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "reservation_ref": { "type": "string", "minLength": 1 },
        "reservation_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "attempt_id": { "type": "string", "minLength": 1 },
        "attempt_ordinal": { "type": "integer", "minimum": 1 },
        "worker_id": { "type": "string", "minLength": 1 },
        "attempt_status": { "enum": ["claimed", "running"] },
        "lease_generation": { "type": "integer", "minimum": 1 },
        "attempt_lease_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "attempt_lease": { "type": "object" },
        "issued_at": { "type": "string", "format": "date-time" },
        "valid_before": { "type": "string", "format": "date-time" },
        "dispatch_authority": { "const": "runner_may_validate_lineage_before_execution" },
        "search_authority": { "const": "none" },
        "review_authority": { "const": "none" },
        "lifecycle_authority": { "const": "none" },
        "economic_authority": { "const": "none" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
