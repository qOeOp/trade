{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.forward-holdout-result.v1",
  "title": "trade-flow forward holdout result",
  "description": "Stable legacy-compatible shape for a read-only post-freeze signal diagnostic; not Forward Evidence authority.",
  "type": "object",
  "required": [
    "strategy_id",
    "setup_id",
    "frozen_at",
    "now",
    "timeframe",
    "status",
    "next_action",
    "frozen_candidate",
    "dataset_count",
    "eligible_count",
    "signal_count",
    "blocked_count",
    "records"
  ],
  "properties": {
    "strategy_id": { "type": "string", "minLength": 1 },
    "setup_id": { "type": "string", "minLength": 1 },
    "frozen_at": { "type": "string", "minLength": 1 },
    "now": { "type": "string", "minLength": 1 },
    "timeframe": { "type": "string", "minLength": 1 },
    "status": { "enum": ["blocked", "waiting_for_signal", "signal_found"] },
    "next_action": { "type": "string", "minLength": 1 },
    "frozen_candidate": {
      "type": "object",
      "required": ["candidate_id", "family", "parameter_count", "candidate_hash"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "parameter_count": { "type": "number" },
        "candidate_hash": { "type": "string", "minLength": 1 }
      }
    },
    "dataset_count": { "type": "number" },
    "eligible_count": { "type": "number" },
    "signal_count": { "type": "number" },
    "blocked_count": { "type": "number" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dataset_id",
          "manifest_path",
          "symbol",
          "latest_candle_open",
          "latest_candle_closed_at",
          "eligible",
          "blocked_by"
        ],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "manifest_path": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "latest_candle_open": { "type": "string" },
          "latest_candle_closed_at": { "type": "string" },
          "eligible": { "type": "boolean" },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["check_id", "reason"],
              "properties": {
                "check_id": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "signal": { "type": "object" }
        }
      }
    }
  }
}
