{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.protocol.rail-ownership-registry.v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "publishers", "consumers", "schema_id", "retention", "replayable"],
    "properties": {
      "id": {
        "type": "string",
        "enum": [
          "command_rail",
          "ops_rail",
          "fact_rail",
          "policy_rail",
          "market_data_rail",
          "exchange_rail",
          "store_rail",
          "data_lineage_rail",
          "artifact_rail",
          "governance_rail"
        ]
      },
      "publishers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "consumers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "schema_id": { "type": "string", "minLength": 1 },
      "retention": { "type": "string", "minLength": 1 },
      "replayable": { "type": "boolean" }
    }
  }
}
