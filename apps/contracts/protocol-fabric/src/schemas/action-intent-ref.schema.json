{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.protocol.action-intent-ref.v1",
  "title": "protocol fabric action intent ref",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_ref", "intent_kind", "status", "source_refs", "content_hash"],
  "properties": {
    "schema_version": { "const": "trade.protocol.action-intent-ref.v1" },
    "intent_ref": { "type": "string", "minLength": 1 },
    "intent_kind": { "type": "string", "enum": ["trade_plan", "watchlist", "no_action"] },
    "status": { "type": "string", "enum": ["proposed", "blocked", "expired"] },
    "symbol": { "type": "string" },
    "side": { "type": "string", "enum": ["long", "short", "flat"] },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "expires_at": { "type": "string" },
    "no_action_reason": { "type": "string" },
    "content_hash": { "type": "string", "minLength": 1 }
  }
}
