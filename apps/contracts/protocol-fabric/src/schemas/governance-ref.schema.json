{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.protocol.governance-ref.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "kind"],
  "properties": {
    "ref": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["evidence_verdict", "promotion_decision", "review_batch", "policy_feedback", "manual_override"]
    },
    "strategy_id": { "type": "string" },
    "cycle_id": { "type": "string" },
    "decision": { "type": "string" }
  }
}
