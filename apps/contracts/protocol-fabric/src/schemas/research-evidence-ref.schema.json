{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.protocol.research-evidence-ref.v1",
  "title": "protocol fabric research evidence ref",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_ref", "evidence_kind", "artifact_refs", "produced_at", "content_hash"],
  "properties": {
    "schema_version": { "const": "trade.protocol.research-evidence-ref.v1" },
    "evidence_ref": { "type": "string", "minLength": 1 },
    "evidence_kind": { "type": "string", "enum": ["experiment", "validation", "shadow", "candidate", "lesson"] },
    "artifact_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "candidate_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "produced_at": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "minLength": 1 }
  }
}
