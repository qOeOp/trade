{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.l2-soak-supervisor-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "symbol", "cycles", "min_valid_frames", "sync_every_frames", "signal", "all_cycle_recovery_parity", "max_rss_bytes", "max_cpu_percent", "killed_cycles", "graceful_restart"],
  "properties": {
    "schema_version": { "const": "trade.l2-soak-supervisor-evidence.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9]{5,20}$" },
    "cycles": { "type": "integer", "minimum": 1, "maximum": 20 },
    "min_valid_frames": { "type": "integer", "minimum": 1 },
    "sync_every_frames": { "type": "integer", "minimum": 1 },
    "signal": { "const": "SIGKILL" },
    "all_cycle_recovery_parity": { "const": true },
    "max_rss_bytes": { "type": "integer", "minimum": 1 },
    "max_cpu_percent": { "type": "number", "minimum": 0 },
    "killed_cycles": { "type": "array", "minItems": 1 },
    "graceful_restart": {
      "type": "object",
      "required": ["exit_code", "evidence_path", "verdict", "total_recorded_events", "total_segments", "max_queue_depth", "max_rss_bytes", "max_cpu_percent"],
      "properties": {
        "exit_code": { "const": 0 },
        "evidence_path": { "type": "string", "minLength": 1 },
        "verdict": { "const": "passed" },
        "total_recorded_events": { "type": "integer", "minimum": 1 },
        "total_segments": { "type": "integer", "minimum": 1 },
        "max_queue_depth": { "type": "integer", "minimum": 0 },
        "max_rss_bytes": { "type": "integer", "minimum": 1 },
        "max_cpu_percent": { "type": "number", "minimum": 0 }
      }
    }
  }
}
