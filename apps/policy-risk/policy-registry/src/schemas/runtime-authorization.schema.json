{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.policy.runtime-authorization.v1",
  "type": "object",
  "required": ["schema_version", "authorization_ref", "policy_ref", "policy_hash", "profile_id", "account_ref", "account_scope", "issued_at", "expires_at", "runtime_policy", "content_hash"],
  "properties": {
    "schema_version": { "const": "trade.policy.runtime-authorization.v1" },
    "authorization_ref": { "type": "string", "pattern": "^policy-authorization://" },
    "policy_ref": { "type": "string", "pattern": "^policy_registry:" },
    "policy_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "profile_id": { "type": "string", "minLength": 1 },
    "account_ref": { "type": "string", "minLength": 1 },
    "account_scope": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "runtime_policy": { "type": "object" },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
