{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.state.portfolio-account-projection.v1",
  "type": "object",
  "required": [
    "schema_version",
    "account_ref",
    "account_scope",
    "computed_at",
    "as_of",
    "completeness",
    "risk_lock",
    "active_plans_risk_sum",
    "current_account_open_risk_usdt",
    "realized_pnl_today_usdt",
    "active_plans_worst_loss_at_stop",
    "active_risk_flow_count",
    "current_gross_notional_usdt",
    "content_hash",
    "projection_ref"
  ],
  "properties": {
    "schema_version": { "const": "trade.state.portfolio-account-projection.v1" },
    "account_ref": { "type": "string", "minLength": 1 },
    "account_scope": { "type": "string", "minLength": 1 },
    "target_symbol": { "type": "string" },
    "computed_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date-time" },
    "source_event_count": { "type": "integer", "minimum": 0 },
    "source_flow_refs": { "type": "array", "items": { "type": "string" } },
    "completeness": { "enum": ["complete", "incomplete"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "risk_lock": { "type": "object" },
    "active_plans_risk_sum": { "type": "number" },
    "current_account_open_risk_usdt": { "type": "number" },
    "realized_pnl_today_usdt": { "type": "number" },
    "active_plans_worst_loss_at_stop": { "type": "number" },
    "active_risk_flow_count": { "type": "integer", "minimum": 0 },
    "current_gross_notional_usdt": { "type": "number" },
    "current_symbol_notional_usdt": { "type": "number" },
    "current_lane_notional_usdt": { "type": "number" },
    "current_lane_position_state": { "type": "string" },
    "open_actions_this_cycle": { "type": "integer", "minimum": 0 },
    "recent_open_actions_1h": { "type": "integer", "minimum": 0 },
    "reconcile_status": { "enum": ["consistent", "blocked"] },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "projection_ref": { "type": "string", "pattern": "^flow-read-models://portfolio-account/" }
  },
  "additionalProperties": true
}
