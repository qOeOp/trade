  classDef state fill:#eefaf0,stroke:#2f7d4f,color:#10351e,stroke-width:1px;
  classDef trade fill:#fff7df,stroke:#b08a00,color:#3b3000,stroke-width:1px;
  classDef research fill:#f2eefe,stroke:#7556b8,color:#241445,stroke-width:1px;
  classDef market fill:#fff0f0,stroke:#b83a3a,color:#471010,stroke-width:1px;
  classDef gov fill:#f0f7f7,stroke:#448080,color:#143838,stroke-width:1px;
  classDef artifact fill:#eef8ff,stroke:#3b82a0,color:#12333f,stroke-width:1px;
  classDef handler fill:#f3f4f6,stroke:#6b7280,color:#111827,stroke-width:1px;
  classDef rail fill:#f8fafc,stroke:#64748b,color:#334155,stroke-width:1px,stroke-dasharray:4 3;
  classDef port fill:#f9fafb,stroke:#6b7280,color:#111827,stroke-width:1px,stroke-dasharray:3 2;
