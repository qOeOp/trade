  classDef domainTitle fill:transparent,stroke:transparent,color:#1f2937,stroke-width:0px;

  class ENTRY,CYCLE,GRAPH,RP,TCFG,STRAT,RISKAUTH center;
  class COMMAND,FACT,POLICYRAIL,MARKETRAIL,EXCHANGERAIL,DATARAIL,ARTIFACTRAIL,GOVRAIL,SCHEMAS rail;
  class OIN,OOUT,PIN,POUT,SIN,SOUT,MDIN,MDOUT,XIN,XOUT,DIN,DOUT,CIN,COUT,RIN,ROUT,GIN,GOUT,AIN,AOUT port;
  class HEALTH,NOTIFY handler;
  class J01,J02,J03,J04,J05,J06,J07,J08,J09 ticket;
  class TDB,PROJ,FLOWIDX,OPSLOG,POLSTORE,INCIDENT,XLEDGER state;
  class WATCH,ALLOC,EXEC,PREF,REC,FAST,EXECREC trade;
  class RDSTATE,RDTOOLS,RDSUP,SIGEVAL,SHADOW research;
  class SCAN,SNAP,RAWMD,TECH,DSETS,MSTORE market;
  class ACC,WRITE market;
  class REVIEW,PROMO,GOVLEDGER gov;
  class CAT,RETAIN,ART artifact;
  class OPAD,FSPAD,JSPAD,PPAD,SPAD,MDPAD,XPAD,DPAD,CPAD,RPAD,GPAD,APAD spacer;
  class ORTITLE,FTITLE,JTITLE,PTITLE,STITLE,MDTITLE,XTITLE,DTITLE,CTITLE,RDTITLE,GTITLE,ATITLE domainTitle;
