flowchart LR
  ENTRY["外部 automation<br/>单一唤醒入口"] --> CYCLE

  subgraph ORCH[" "]
    direction TB
    ORTITLE["控制塔域<br/>control tower / orchestration-ops"]
    OPAD[" "]
    OIN["domain inbox<br/>wakeup / job result refs"]
    CYCLE["cycle planner<br/>生成本轮 job plan"]
    GRAPH["job graph protocol<br/>scope / contract / idempotency / write owner"]
    HEALTH["runtime health collector<br/>配置 / API / DB / lock / safe mode facts"]
    NOTIFY["notify dispatcher<br/>cycle 异常 / 人工接管提醒"]
    OPSLOG[("ops runtime store<br/>lock / health / cycle summary")]
    OOUT["domain outbox<br/>job graph / health facts / cycle summary"]
    ORTITLE ~~~ OPAD
    OPAD ~~~ CYCLE
    CYCLE --> GRAPH
    OIN --> HEALTH
    OIN --> NOTIFY
    HEALTH --> OPSLOG
    NOTIFY --> OPSLOG
    OPSLOG --> OOUT
  end

  subgraph FABRIC[" "]
    direction TB
    FTITLE["通信协议层<br/>protocol fabric / logical bus"]
    FSPAD[" "]
    SCHEMAS["contract schema registry<br/>job / command / event / ref / store envelopes"]
    COMMAND["command rail<br/>job tickets / command_spec / retry key"]
    FACT["fact rail<br/>event write envelopes / read model refs"]
    POLICYRAIL["policy rail<br/>approved snapshot / runtime policy / trading mode"]
    MARKETRAIL["market data rail<br/>fresh facts / feature refs"]
    EXCHANGERAIL["exchange rail<br/>account/order facts / write requests"]
    STORERAIL["store rail<br/>logical-store-ref / owner write contract"]
    DATARAIL["data lineage rail<br/>raw -> canonical -> feature -> dataset -> evidence"]
    ARTIFACTRAIL["artifact rail<br/>refs / catalog summary"]
    GOVRAIL["governance rail<br/>evidence / promotion decision refs"]
    FTITLE ~~~ FSPAD
    FSPAD ~~~ SCHEMAS
    SCHEMAS ~~~ COMMAND
    SCHEMAS ~~~ STORERAIL
  end

  subgraph JOBS[" "]
    direction TB
    JTITLE["本轮 job tickets<br/>cycle fork"]
    JSPAD[" "]
    J01["J01<br/>runtime health"]
    J02["J02<br/>account reconcile"]
    J03["J03<br/>fast guard"]
    J04["J04<br/>slow watch"]
    J05["J05<br/>R&D loop"]
    J06["J06<br/>shadow tracking"]
    J07["J07<br/>catalog hygiene"]
    J08["J08<br/>closed-flow review"]
    J09["J09<br/>ops notify"]
    JTITLE ~~~ JSPAD
    JSPAD ~~~ J01
  end

  subgraph POLICY[" "]
    direction TB
    PTITLE["政策与风险域<br/>policy-risk"]
    PPAD[" "]
    PIN["domain inbox<br/>config / health / evidence refs"]
    TCFG["trading config<br/>项目级交易配置"]
    STRAT["approved strategy contracts<br/>策略池 / Trade Contract"]
    RP["runtime policy<br/>权限 / 风险 / 成本模型"]
    RISKAUTH["risk authority<br/>trading mode / kill switch / reduce-only"]
    INCIDENT[("incident / override registry<br/>pause / reduce-only / manual approval")]
    POLSTORE[("policy snapshot registry<br/>policy hash / approved status / mode")]
    POUT["domain outbox<br/>runtime policy + trading mode snapshot"]
    PTITLE ~~~ PPAD
    PPAD ~~~ PIN
    PIN --> STRAT
    TCFG --> RP
    STRAT --> RP
    STRAT --> POLSTORE
    PIN --> RISKAUTH
    RP --> RISKAUTH
    RISKAUTH --> INCIDENT
    INCIDENT --> POLSTORE
    RISKAUTH --> POLSTORE
    POLSTORE --> POUT
  end

  subgraph STATE[" "]
    direction TB
    STITLE["组合与执行状态域<br/>portfolio-execution-state"]
    SPAD[" "]
    SIN["domain inbox<br/>event write envelopes"]
    TDB[("trade.db<br/>plan_event<br/>observe / order_fill / review")]
    PROJ["flow projector<br/>active flows / open risk<br/>closed-unreviewed flows"]
    FLOWIDX[("flow read models<br/>active / exposure / review queue")]
    SOUT["domain outbox<br/>read model refs"]
    STITLE ~~~ SPAD
    SPAD ~~~ SIN
    SIN --> TDB
    TDB --> PROJ
    PROJ --> FLOWIDX
    FLOWIDX --> SOUT
  end

  subgraph MARKETDATA[" "]
    direction TB
    MDTITLE["市场数据产品域<br/>market-data-products"]
    MDPAD[" "]
    MDIN["domain inbox<br/>market refresh / query refs"]
    SCAN["universe / liquidity scan<br/>可交易性粗筛"]
    SNAP["symbol snapshot<br/>mark / funding / OI"]
    RAWMD["raw market capture<br/>OHLCV / funding / aggtrades"]
    MSTORE[("canonical market store<br/>closed candles / funding / checksums")]
    TECH["feature engine<br/>indicator / structure / regime"]
    DSETS["dataset manifests<br/>panel / split / feature refs"]
    MDOUT["domain outbox<br/>market facts / dataset refs"]
    MDTITLE ~~~ MDPAD
    MDPAD ~~~ MDIN
    MDIN --> RAWMD
    MDIN --> SCAN
    MDIN --> SNAP
    RAWMD --> MSTORE
    MSTORE --> TECH
    TECH --> DSETS
    SCAN --> MDOUT
    SNAP --> MDOUT
    TECH --> MDOUT
    DSETS --> MDOUT
  end

  subgraph EXCHANGE[" "]
    direction TB
    XTITLE["交易所网关域<br/>exchange-gateway"]
    XPAD[" "]
    XIN["domain inbox<br/>account read / authorized write requests"]
    ACC["account / order snapshot<br/>账户 / 仓位 / 挂单 / fills"]
    WRITE["exchange write adapter<br/>下单 / 撤单 / 保护 / 减仓"]
    XLEDGER[("exchange command ledger<br/>client order id / request-result refs")]
    XOUT["domain outbox<br/>account facts / write result refs"]
    XTITLE ~~~ XPAD
    XPAD ~~~ XIN
    XIN --> ACC
    XIN --> WRITE
    ACC --> XOUT
    WRITE --> XLEDGER
    XLEDGER --> XOUT
  end

  subgraph DECISION[" "]
    direction TB
    DTITLE["现场决策域<br/>live-decision-planning"]
    DPAD[" "]
    DIN["domain inbox<br/>J04 + input refs"]
    WATCH["opportunity planner<br/>watchlist / thesis / no_action"]
    ALLOC["sizing / risk-budget planner<br/>entry / stop / action_intent"]
    DOUT["domain outbox<br/>intent / watchlist refs"]
    DTITLE ~~~ DPAD
    DPAD ~~~ DIN
    DIN --> WATCH
    WATCH --> ALLOC
    ALLOC --> DOUT
  end

  subgraph CONTROL[" "]
    direction TB
    CTITLE["受控执行域<br/>live-execution-control"]
    CPAD[" "]
    CIN["domain inbox<br/>J02 / J03 + executable intents"]
    REC["recovery-runner / reconcile-drafts<br/>恢复与对账"]
    FAST["execution-flow-runner<br/>fast guard / dry-run / shadow"]
    EXEC["live-small-runner<br/>explicit yes / command_spec execution"]
    PREF["preflight / hard guards<br/>确定性风控"]
    EXECREC["execution recorder<br/>order_fill / blocked observe"]
    COUT["domain outbox<br/>event drafts / exchange command refs"]
    CTITLE ~~~ CPAD
    CPAD ~~~ CIN
    CIN --> REC
    CIN --> FAST
    CIN --> EXEC
    EXEC --> PREF
    PREF -->|"pass"| COUT
    PREF -->|"blocked"| EXECREC
    REC --> COUT
    FAST --> COUT
    EXECREC --> COUT
  end

  subgraph RESEARCH[" "]
    direction TB
    RDTITLE["策略研发域<br/>research-strategy-development"]
    RPAD[" "]
    RIN["domain inbox<br/>J05 / J06 + research refs"]
    RDSUP["research supervisor<br/>hypothesis loop"]
    RDTOOLS["experiment runners<br/>split / replay / panel / candidate / benchmark"]
    SIGEVAL["signal evaluator<br/>latest signal / candidate check"]
    SHADOW["shadow tracker<br/>forward / paper samples"]
    RDSTATE[("rd state store<br/>hypothesis / budget / lessons")]
    ROUT["domain outbox<br/>research / shadow refs"]
    RDTITLE ~~~ RPAD
    RPAD ~~~ RIN
    RIN --> RDSUP
    RIN --> SHADOW
    RDSUP --> RDTOOLS
    RDTOOLS --> SIGEVAL
    RDTOOLS -->|"实验结果 / lessons"| RDSTATE
    RDSTATE -->|"next hypothesis refs"| RDSUP
    RDSUP --> ROUT
    SHADOW --> ROUT
    RDSTATE --> ROUT
  end

  subgraph GOV[" "]
    direction TB
    GTITLE["治理复盘域<br/>governance-review-compliance"]
    GPAD[" "]
    GIN["domain inbox<br/>J08 + evidence refs"]
    REVIEW["closed-flow reviewer<br/>交易复盘 / 资格反馈"]
    PROMO["promotion gate<br/>资格判定 / evidence"]
    GOVLEDGER[("governance ledger<br/>evidence / promotion decisions")]
    GOUT["domain outbox<br/>review / promotion refs"]
    GTITLE ~~~ GPAD
    GPAD ~~~ GIN
    GIN --> REVIEW
    GIN --> PROMO
    REVIEW --> PROMO
    REVIEW --> GOVLEDGER
    PROMO --> GOVLEDGER
    GOVLEDGER --> GOUT
  end

  subgraph ARTIFACTS[" "]
    direction TB
    ATITLE["知识资产域<br/>artifact-knowledge"]
    APAD[" "]
    AIN["domain inbox<br/>artifact register / query / GC"]
    CAT["catalog service<br/>索引 / stale / GC"]
    RETAIN["retention / pin / lineage<br/>保留 / 引用 / 血缘"]
    ART[("data_catalog.db + artifacts<br/>研究 / 盯市 / 复盘资产")]
    AOUT["domain outbox<br/>catalog summary refs"]
    ATITLE ~~~ APAD
    APAD ~~~ AIN
    AIN --> CAT
    CAT --> RETAIN
    RETAIN --> ART
    ART --> AOUT
  end

  GRAPH --> COMMAND
  OOUT --> COMMAND
  OOUT --> POLICYRAIL

  COMMAND --> J01
  COMMAND --> J02
  COMMAND --> J03
  COMMAND --> J04
  COMMAND --> J05
  COMMAND --> J06
  COMMAND --> J07
  COMMAND --> J08
  COMMAND --> J09

  J01 --> OIN
  J09 --> OIN
  J02 --> CIN
  J03 --> CIN
  J04 --> DIN
  J05 --> RIN
  J06 --> RIN
  J07 --> AIN
  J08 --> GIN

  FACT -. "job input refs" .-> COMMAND
  POLICYRAIL -. "job input refs" .-> COMMAND
  MARKETRAIL -. "job input refs" .-> COMMAND
  EXCHANGERAIL -. "job input refs" .-> COMMAND
  DATARAIL -. "job input refs" .-> COMMAND
  ARTIFACTRAIL -. "job input refs" .-> COMMAND
  GOVRAIL -. "job input refs" .-> COMMAND
  POLICYRAIL -. "trading mode gates" .-> DIN
  POLICYRAIL -. "trading mode gates" .-> CIN
  POLICYRAIL -. "authorized write mode" .-> XIN

  POUT --> POLICYRAIL
  SOUT --> FACT
  MDOUT --> MARKETRAIL
  MDOUT --> DATARAIL
  DSETS --> DATARAIL
  XOUT --> EXCHANGERAIL
  DOUT --> FACT
  DOUT --> ARTIFACTRAIL
  COUT --> FACT
  COUT --> EXCHANGERAIL
  ROUT --> ARTIFACTRAIL
  ROUT --> DATARAIL
  GOUT --> FACT
  GOUT --> ARTIFACTRAIL
  GOUT --> GOVRAIL
  AOUT --> ARTIFACTRAIL
  AOUT --> DATARAIL

  FACT --> SIN
  MARKETRAIL --> MDIN
  EXCHANGERAIL --> XIN
  GOVRAIL --> PIN
  ARTIFACTRAIL --> AIN

