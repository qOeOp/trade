flowchart LR
  ENTRY["外部 automation / user takeover<br/>单一唤醒入口"] --> OIN

  subgraph ORCH[" "]
    direction TB
    ORTITLE["控制塔域<br/>control tower / orchestration-ops"]
    OPAD[" "]
    OIN["domain inbox<br/>wakeup / job result refs"]
    CYCLE["cycle planner<br/>生成本轮 job plan"]
    HOOKS["lifecycle hooks + processors<br/>pre_cycle / pre_job / post_job / post_cycle"]
    GRAPH["job graph protocol<br/>scope / contract / idempotency / write owner"]
    HEALTH["runtime health guard<br/>配置 / API / DB / lock / safe mode facts"]
    POST["result post-processor<br/>envelope / outbox / write-scope / failure analyzer / incident refs"]
    IMGR["incident manager<br/>classify / ack / resolve / next-cycle constraints"]
    CREVIEW["control effectiveness review<br/>incidents / overrides / repeated failures"]
    NOTIFY["notify dispatcher<br/>cycle 异常 / 人工接管提醒"]
    INCIDENTSTORE[("incident store<br/>system problems / ack / resolution")]
    OPSLOG[("ops runtime store<br/>lock / health / job results / cycle summary")]
    OOUT["domain outbox<br/>job graph / health facts / incidents / cycle summary"]
    ORTITLE ~~~ OPAD
    OPAD ~~~ CYCLE
    CYCLE --> HOOKS
    HOOKS --> GRAPH
    HOOKS --> HEALTH
    OIN --> HOOKS
    OIN --> POST
    HEALTH --> POST
    POST --> IMGR
    GRAPH --> OPSLOG
    IMGR --> NOTIFY
    IMGR --> INCIDENTSTORE
    INCIDENTSTORE --> CREVIEW
    CREVIEW --> OPSLOG
    POST --> OPSLOG
    NOTIFY --> OPSLOG
    OPSLOG --> OOUT
  end

  subgraph FABRIC[" "]
    direction TB
    FTITLE["通信协议层<br/>protocol fabric / logical bus"]
    FSPAD[" "]
    SCHEMAS["contract schema registry<br/>job / command / event / ref / store envelopes"]
    RAILHDR["rail envelope header<br/>rail / source / target / schema / idempotency / refs"]
    RAILACL["rail ownership registry<br/>publishers / consumers / retention"]
    DOMAINRT["domain runtime contract<br/>hooks / result envelope / failure classes"]
    COMMAND["command rail<br/>job tickets / command_spec / retry key"]
    OPSRAIL["ops rail<br/>health facts / incident refs / cycle summary"]
    FACT["fact rail<br/>event write envelopes / read model refs"]
    POLICYRAIL["policy rail<br/>approved snapshot / runtime policy / trading profile-mode"]
    MARKETRAIL["market data rail<br/>fresh facts / feature refs"]
    EXCHANGERAIL["exchange rail<br/>account/order facts / write requests"]
    STORERAIL["store rail<br/>logical-store-ref / owner write contract"]
    DATARAIL["data lineage rail<br/>raw -> canonical -> feature -> dataset -> evidence"]
    ARTIFACTRAIL["artifact rail<br/>refs / catalog summary"]
    GOVRAIL["governance rail<br/>evidence / promotion decision refs"]
    FTITLE ~~~ FSPAD
    FSPAD ~~~ SCHEMAS
    SCHEMAS -. "schema governs" .-> RAILHDR
    RAILHDR -. "rail route + refs" .-> RAILACL
    RAILACL -. "allowed pub/sub" .-> DOMAINRT
    SCHEMAS -. "schema governs" .-> DOMAINRT
    SCHEMAS -. "schema governs" .-> COMMAND
    SCHEMAS -. "schema governs" .-> OPSRAIL
    SCHEMAS -. "schema governs" .-> FACT
    SCHEMAS -. "schema governs" .-> POLICYRAIL
    SCHEMAS -. "schema governs" .-> MARKETRAIL
    SCHEMAS -. "schema governs" .-> EXCHANGERAIL
    SCHEMAS -. "schema governs" .-> STORERAIL
    SCHEMAS -. "schema governs" .-> DATARAIL
    SCHEMAS -. "schema governs" .-> ARTIFACTRAIL
    SCHEMAS -. "schema governs" .-> GOVRAIL
    DOMAINRT -. "lifecycle envelope" .-> COMMAND
  end

  subgraph JOBS[" "]
    direction TB
    JTITLE["本轮 domain job tickets<br/>cycle fork"]
    JSPAD[" "]
    J01["J01 account reconcile<br/>交易所事实对账<br/>write: reconcile / needs_review"]
    J02["J02 fast guard<br/>active flow 执行守卫<br/>write: light observe / order_fill"]
    J03["J03 slow watch<br/>慢轨机会与计划<br/>write: full observe / action_intent"]
    J04["J04 R&D loop<br/>假设迭代与候选冻结<br/>write: research state / artifacts"]
    J05["J05 shadow tracking<br/>forward / paper 样本跟踪<br/>write: shadow artifacts"]
    J06["J06 catalog hygiene<br/>证据索引与保留清理<br/>write: catalog metadata"]
    J07["J07 closed-flow review<br/>闭合 flow 复盘与反馈<br/>write: review / governance evidence"]
    JTITLE ~~~ JSPAD
    JSPAD ~~~ J01
  end

  subgraph POLICY[" "]
    direction TB
    PTITLE["政策与风险域<br/>policy-risk"]
    PPAD[" "]
    PIN["domain inbox<br/>config / ops / governance refs"]
    TCFG["trading config<br/>项目级交易配置"]
    STRAT["approved strategy contracts<br/>governance-approved Trade Contract"]
    RP["runtime policy compiler<br/>权限 / 风险上限 / 成本模型"]
    RISKAUTH["trading mode authority<br/>mode state machine / kill switch / reduce-only"]
    OVERRIDE[("mode override ledger<br/>manual override / downgrade reason refs")]
    POLSTORE[("policy snapshot registry<br/>policy hash / approved refs")]
    MODESTORE[("mode decision ledger<br/>profile-mode / reason refs / expiry")]
    POUT["domain outbox<br/>runtime policy + mode snapshot refs"]
    PTITLE ~~~ PPAD
    PPAD ~~~ PIN
    PIN --> STRAT
    TCFG --> RP
    STRAT --> RP
    STRAT --> POLSTORE
    PIN --> RISKAUTH
    RP --> RISKAUTH
    RISKAUTH --> OVERRIDE
    OVERRIDE --> MODESTORE
    RISKAUTH --> MODESTORE
    RP --> POLSTORE
    POLSTORE --> POUT
    MODESTORE --> POUT
  end

  subgraph STATE[" "]
    direction TB
    STITLE["组合与执行状态域<br/>portfolio-execution-state"]
    SPAD[" "]
    SIN["domain inbox<br/>event write envelopes"]
    APPEND["event owner tools<br/>append / read / latest fill / chain scan"]
    TDB[("trade_event_store<br/>append-only plan_event<br/>observe / order_fill / review")]
    PROJ["flow projector<br/>active flows / open risk<br/>latest slow observe"]
    FLOWIDX[("flow read models<br/>active / exposure / review queue")]
    PUBLISH["read-model publisher<br/>projection refs / freshness / rebuildable"]
    SOUT["domain outbox<br/>flow read model refs"]
    STITLE ~~~ SPAD
    SPAD ~~~ SIN
    SIN --> APPEND
    APPEND --> TDB
    TDB --> PROJ
    PROJ --> FLOWIDX
    FLOWIDX --> PUBLISH
    PUBLISH --> SOUT
  end

  subgraph MARKETDATA[" "]
    direction TB
    MDTITLE["市场数据产品域<br/>market-data-products"]
    MDPAD[" "]
    MDIN["domain inbox<br/>market refresh / query refs"]
    MDROUTE["market request router<br/>refresh / query / dataset build"]
    SCAN["universe / liquidity scan<br/>可交易性粗筛"]
    SNAP["symbol snapshot<br/>mark / funding / OI"]
    RAWMD["raw market capture<br/>OHLCV / funding / aggtrades"]
    MDQUAL["data quality gate<br/>closed candle / gaps / checksum / freshness"]
    MSTORE[("canonical market store<br/>closed candles / funding / checksums")]
    TECH["feature engine<br/>indicator / structure / regime"]
    DSETS["dataset manifests<br/>panel / split / feature refs"]
    MDPUB["market fact publisher<br/>freshness / time window / refs"]
    MDOUT["domain outbox<br/>market facts / dataset refs"]
    MDTITLE ~~~ MDPAD
    MDPAD ~~~ MDIN
    MDIN --> MDROUTE
    MDROUTE --> RAWMD
    MDROUTE --> SCAN
    MDROUTE --> SNAP
    RAWMD --> MDQUAL
    MDQUAL --> MSTORE
    MSTORE --> TECH
    TECH --> DSETS
    SCAN --> MDPUB
    SNAP --> MDPUB
    TECH --> MDPUB
    DSETS --> MDPUB
    MDPUB --> MDOUT
  end

  subgraph EXCHANGE[" "]
    direction TB
    XTITLE["交易所网关域<br/>exchange-gateway"]
    XPAD[" "]
    XIN["domain inbox<br/>read requests / authorized write requests"]
    XROUTE["exchange request router<br/>read vs write / mode / idempotency"]
    ACC["account fact reader<br/>账户 / 仓位 / 挂单 / fills"]
    WRITEPRE["write pre-adapter gate<br/>authorized mode / client id / exchange rules"]
    WRITE["exchange write adapter<br/>下单 / 撤单 / 保护 / 减仓"]
    CONFIRM["post-write confirmation<br/>result normalize / account-order reread"]
    XLEDGER[("exchange command ledger<br/>command / request / result / confirmation refs")]
    XOUT["domain outbox<br/>account facts / write result / confirmation refs"]
    XTITLE ~~~ XPAD
    XPAD ~~~ XIN
    XIN --> XROUTE
    XROUTE --> ACC
    XROUTE --> WRITEPRE
    WRITEPRE --> XLEDGER
    WRITEPRE --> WRITE
    WRITE --> CONFIRM
    CONFIRM --> XLEDGER
    ACC --> XLEDGER
    ACC --> XOUT
    WRITE -->|"submit result"| XLEDGER
    XLEDGER --> XOUT
  end

  subgraph DECISION[" "]
    direction TB
    DTITLE["现场决策域<br/>live-decision-planning"]
    DPAD[" "]
    DIN["domain inbox<br/>J03 + policy / market / flow refs"]
    DASM["decision input assembler<br/>policy + market + flow + evidence refs"]
    WATCH["opportunity planner<br/>watchlist / thesis / no_action"]
    PLAN["trade plan builder<br/>entry / stop / invalidation / trigger"]
    ALLOC["sizing / risk-budget planner<br/>size / exposure budget / expiry"]
    DPUB["action intent publisher<br/>intent refs / no_action reason"]
    DOUT["domain outbox<br/>intent / watchlist refs"]
    DTITLE ~~~ DPAD
    DPAD ~~~ DIN
    DIN --> DASM
    DASM --> WATCH
    WATCH --> PLAN
    WATCH -->|"no_action"| DPUB
    PLAN --> ALLOC
    ALLOC --> DPUB
    DPUB --> DOUT
  end

  subgraph CONTROL[" "]
    direction TB
    CTITLE["受控执行域<br/>live-execution-control"]
    CPAD[" "]
    CIN["domain inbox<br/>J01 / J02 + executable intents / exchange result refs"]
    EROUTE["execution action router<br/>reconcile / fast / live-small / record"]
    REC["recovery runner<br/>reconcile drafts / needs_review"]
    FAST["fast guard<br/>trigger / protection / defense"]
    EXEC["live-small runner<br/>explicit yes / live command"]
    EGATE["execution gate<br/>trigger / idempotency / mode scope"]
    PREF["preflight / hard guards<br/>policy + flow + exchange + market facts"]
    CMDCOMP["execution command compiler<br/>command_spec / contract snapshot"]
    EXECREC["execution recorder<br/>exchange result -> order_fill draft<br/>blocked -> observe draft"]
    COUT["domain outbox<br/>event drafts / exchange command refs"]
    CTITLE ~~~ CPAD
    CPAD ~~~ CIN
    CIN --> EROUTE
    EROUTE --> REC
    EROUTE --> FAST
    EROUTE --> EXEC
    EROUTE --> EXECREC
    REC --> EXECREC
    FAST --> EGATE
    EXEC --> EGATE
    EGATE --> PREF
    PREF -->|"pass"| CMDCOMP
    PREF -->|"blocked"| EXECREC
    CMDCOMP --> COUT
    EXECREC --> COUT
  end

  subgraph RESEARCH[" "]
    direction TB
    RDTITLE["策略研发域<br/>research-strategy-development"]
    RPAD[" "]
    RIN["domain inbox<br/>J04 / J05 + research / data refs"]
    RDSUP["research supervisor<br/>hypothesis queue / budget / lessons"]
    RDDESIGN["experiment design gate<br/>dataset manifest / split / leakage / budget"]
    RDTOOLS["experiment runners<br/>replay / panel / candidate / benchmark"]
    SIGEVAL["signal evaluator<br/>performance / robustness / failure reason"]
    FREEZE["candidate freezer<br/>gated draft / assumptions / limits"]
    SHADOW["shadow tracker<br/>forward / paper samples"]
    SHADOWLEDGER[("shadow ledger<br/>paper fills / sample health / drift")]
    RDSTATE[("rd state store<br/>hypothesis / budget / lessons / queue")]
    RDPUB["research evidence publisher<br/>artifact refs / candidate refs"]
    ROUT["domain outbox<br/>research / shadow / candidate refs"]
    RDTITLE ~~~ RPAD
    RPAD ~~~ RIN
    RIN --> RDSUP
    RIN --> SHADOW
    RDSUP --> RDDESIGN
    RDDESIGN --> RDTOOLS
    RDTOOLS --> SIGEVAL
    RDTOOLS -->|"实验结果 / lessons"| RDSTATE
    SIGEVAL --> FREEZE
    SIGEVAL -->|"failure / calibration lessons"| RDSTATE
    RDSTATE -->|"next hypothesis refs"| RDSUP
    FREEZE --> RDPUB
    SHADOW --> SHADOWLEDGER
    SHADOWLEDGER --> RDPUB
    RDSTATE --> RDPUB
    RDPUB --> ROUT
  end

  subgraph GOV[" "]
    direction TB
    GTITLE["治理复盘域<br/>governance-review-compliance"]
    GPAD[" "]
    GIN["domain inbox<br/>J07 + evidence refs"]
    EVGATE["evidence intake gate<br/>freshness / data hash / policy hash"]
    REVIEW["closed-flow reviewer<br/>execution attribution / cost / slippage"]
    PROMO["promotion gate<br/>candidate qualification / expiry"]
    POLFB["policy feedback compiler<br/>risk limits / deprecation suggestions"]
    GOVLEDGER[("governance ledger<br/>review / promotion / feedback decisions")]
    GOUT["domain outbox<br/>review / promotion refs"]
    GTITLE ~~~ GPAD
    GPAD ~~~ GIN
    GIN --> EVGATE
    EVGATE --> REVIEW
    EVGATE --> PROMO
    REVIEW --> PROMO
    REVIEW --> POLFB
    REVIEW --> GOVLEDGER
    PROMO --> GOVLEDGER
    POLFB --> GOVLEDGER
    GOVLEDGER --> GOUT
  end

  subgraph ARTIFACTS[" "]
    direction TB
    ATITLE["知识资产域<br/>artifact-knowledge"]
    APAD[" "]
    AIN["domain inbox<br/>artifact register / query / GC"]
    AREG["artifact intake gate<br/>schema / hash / owner / refs"]
    CAT["catalog service<br/>index / stale / discoverability"]
    LINEAGE["lineage indexer<br/>source refs / derived refs / backlinks"]
    RETAIN["retention / pin / GC planner<br/>保留 / 引用 / 清理候选"]
    ART[("data_catalog.db + artifacts<br/>研究 / 盯市 / 复盘资产")]
    APUB["catalog summary publisher<br/>query result / stale candidate refs"]
    AOUT["domain outbox<br/>catalog summary / lineage refs"]
    ATITLE ~~~ APAD
    APAD ~~~ AIN
    AIN --> AREG
    AIN --> APUB
    AREG --> CAT
    CAT --> LINEAGE
    LINEAGE --> RETAIN
    RETAIN --> ART
    ART --> APUB
    APUB --> AOUT
  end

  subgraph DATAPLANE[" "]
    direction TB
    LDTITLE["本地数据平面<br/>local data plane"]
    LDPAD[" "]
    SQLITE[("SQLite logical stores<br/>data/*.db<br/>facts / ledgers / refs / summaries<br/>market_data_store / research_state_store")]
    FILES[("durable file payloads<br/>data/artifacts / raw archives<br/>large bodies only, not owner state")]
    TMPFILES[("ephemeral workspace payloads<br/>tmp/artifacts / tmp/panels / tmp/market<br/>可再生中间产物")]
    CATIDX["catalog index contract<br/>DB stores refs / hash / lineage / retention<br/>files store large bodies"]
    LDTITLE ~~~ LDPAD
    LDPAD ~~~ SQLITE
    SQLITE --> CATIDX
    FILES --> CATIDX
    TMPFILES --> CATIDX
  end

