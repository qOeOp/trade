flowchart TB
  %% Cross-domain communication lanes. Domains may appear in more than one lane;
  %% the canonical publisher/consumer list lives in design-architecture.md.

  subgraph SCHEDULE["1. Scheduling lane — targeted commands, bounded results"]
    direction LR
    S_ORCH["orchestration-ops"] --> S_CMD["COMMAND<br/>ticket / scope / input refs"]
    S_CMD --> S_TARGETS["scheduled domain targets<br/>decision / execution / research<br/>governance / artifact"]
    S_TARGETS --> S_RESULT["RESULT<br/>status / output refs<br/>requested effects / incidents"]
    S_RESULT --> S_ORCH
  end

  subgraph AUTH["2. Authorization lane — constraints never become trade facts"]
    direction LR
    A_OPS["orchestration-ops<br/>health / lock / safe mode"] --> A_POLICY["policy-risk"]
    A_GOV["governance<br/>promotion / expiry / feedback"] --> A_POLICY
    A_POLICY --> A_SNAPSHOT["AUTHORIZATION<br/>profile-mode / limits / permissions<br/>policy hash / expiry"]
    A_SNAPSHOT --> A_DECISION["live-decision-planning"]
    A_SNAPSHOT --> A_EXECUTION["live-execution-control"]
    A_SNAPSHOT --> A_EXCHANGE["exchange write gate"]
  end

  subgraph LIVE["3. Live trading lane — intent, privileged side effect, authoritative state"]
    direction LR
    L_MARKET["market-data-products<br/>market facts"] --> L_INPUTS["DECISION INPUT REFS<br/>freshness / watermark / source"]
    L_EXCHANGE_FACTS["exchange-gateway<br/>account facts"] --> L_INPUTS
    L_STATE_FACTS["portfolio-execution-state<br/>portfolio / flow projection"] --> L_INPUTS
    L_INPUTS --> L_DECISION["live-decision-planning"]
    L_DECISION --> L_INTENT["INTENT<br/>plan / proposed allocation / expiry"]
    L_INTENT --> L_EXECUTION["live-execution-control<br/>preflight / capability boundary"]
    L_EXECUTION --> L_COMMAND["PRIVILEGED COMMAND<br/>bounded effect / idempotency"]
    L_COMMAND --> L_EXCHANGE["exchange-gateway<br/>venue side effect owner"]
    L_EXCHANGE --> L_RESULT["EXCHANGE RESULT<br/>accepted / rejected / unknown / confirmed"]
    L_RESULT --> L_EXECUTION
    L_EXECUTION --> L_EVENT["EVENT / RECONCILE PROPOSAL<br/>source refs / confirmation refs"]
    L_EVENT --> L_STATE["portfolio-execution-state<br/>event and projection owner"]
  end

  subgraph EVIDENCE["4. Evidence lane — research cannot approve itself"]
    direction LR
    E_MARKET["market-data-products"] --> E_DATASET["DATASET REF<br/>manifest / lineage / watermark"]
    E_DATASET --> E_RESEARCH["research-strategy-development"]
    E_RESEARCH --> E_EVIDENCE["EVIDENCE REF<br/>Trial / Result / Forward / candidate"]
    E_EVIDENCE --> E_GOV["governance-review-compliance"]
    E_GOV --> E_DECISION["LIFECYCLE DECISION<br/>reject / revise / promote / expire"]
    E_DECISION --> E_RESEARCH
    E_GOV --> E_FEEDBACK["POLICY FEEDBACK<br/>scoped proposal, not runtime policy"]
    E_FEEDBACK --> E_POLICY["policy-risk"]
    E_PRODUCERS["research / governance / decision"] --> E_REGISTER["ARTIFACT REGISTRATION<br/>hash / owner / lineage / retention"]
    E_REGISTER --> E_ARTIFACT["artifact-knowledge"]
    E_ARTIFACT --> E_QUERY["QUERY RESULT<br/>catalog refs / metadata"]
    E_QUERY --> E_CONSUMERS["authorized consumers"]
  end

  LEGEND["Route invariants<br/>COMMAND is targeted · FACT may fan out<br/>INTENT is not authorization · REF is not store access<br/>QUERY uses the owner port · privileged routes are least-privilege"]

  S_ORCH ~~~ A_OPS
  A_OPS ~~~ L_MARKET
  L_MARKET ~~~ E_MARKET
  E_MARKET ~~~ LEGEND

  classDef control fill:#eaf4ff,stroke:#2f6fb0,color:#0b2540;
  classDef live fill:#fff7df,stroke:#b08a00,color:#3b3000;
  classDef evidence fill:#f2eefe,stroke:#7556b8,color:#241445;
  classDef contract fill:#f8fafc,stroke:#64748b,color:#334155,stroke-dasharray:4 3;
  class S_ORCH,A_OPS,A_POLICY,A_GOV,A_DECISION,A_EXECUTION,A_EXCHANGE,E_POLICY control;
  class L_MARKET,L_EXCHANGE_FACTS,L_STATE_FACTS,L_DECISION,L_EXECUTION,L_EXCHANGE,L_STATE live;
  class E_MARKET,E_RESEARCH,E_GOV,E_ARTIFACT,E_PRODUCERS,E_CONSUMERS evidence;
  class S_CMD,S_TARGETS,S_RESULT,A_SNAPSHOT,L_INPUTS,L_INTENT,L_COMMAND,L_RESULT,L_EVENT,E_DATASET,E_EVIDENCE,E_DECISION,E_FEEDBACK,E_REGISTER,E_QUERY,LEGEND contract;
