flowchart TB
  %% Current runtime projection. Ticket count and cadence may evolve without
  %% changing the authority map in architecture-overview-v2.mmd.

  ENTRY["External automation / operator wakeup"] --> LOCK["cycle lock + runtime health"]
  LOCK --> PRE["pre_cycle / ticket planning<br/>scope / refs / write effects / stop conditions"]

  PRE --> SERIAL["serial trade-state guard"]
  SERIAL --> J01["J01 account reconcile<br/>target: live-execution-control"]
  J01 --> J02["J02 fast guard<br/>target: live-execution-control"]

  J02 --> FORK["isolated work fork"]
  FORK --> J03["J03 read-only decision chain<br/>DecisionInput / TradePlan / Proposal / ActionIntent<br/>target: live-decision-planning · no trade.db write"]
  FORK --> J04["J04 historical R&D<br/>target: research-strategy-development"]
  FORK --> J05["J05 forward evidence<br/>target: research-strategy-development"]
  FORK --> J06["J06 catalog hygiene<br/>target: artifact-knowledge"]

  J03 --> JOIN["result envelope join"]
  J04 --> JOIN
  J05 --> JOIN
  J06 --> JOIN
  J02 --> JOIN

  JOIN --> J07["J07 closed-flow review<br/>target: governance-review-compliance"]
  J07 --> POST["domain hooks + post_cycle<br/>pre_accept → pre_handle → handler<br/>post_handle → post_commit → outbox / on_error"]
  POST --> OPS["cycle summary / notify / control review"]
  OPS --> OUT["next-cycle constraints / operator takeover"]

  RESULT["Every job returns<br/>status / input refs / output refs<br/>requested effects / incidents / hook audit"]
  J01 -.-> RESULT
  J02 -.-> RESULT
  J03 -.-> RESULT
  J04 -.-> RESULT
  J05 -.-> RESULT
  J06 -.-> RESULT
  J07 -.-> RESULT

  NOTE["Runtime view only<br/>Jobs schedule domain capabilities;<br/>they do not own domains, stores or business authority."]

  classDef lifecycle fill:#eaf4ff,stroke:#2f6fb0,color:#0b2540;
  classDef ticket fill:#fff8df,stroke:#b08a00,color:#3b3000;
  classDef envelope fill:#f8fafc,stroke:#64748b,color:#334155,stroke-dasharray:4 3;
  class ENTRY,LOCK,PRE,SERIAL,FORK,JOIN,POST,OPS,OUT lifecycle;
  class J01,J02,J03,J04,J05,J06,J07 ticket;
  class RESULT,NOTE envelope;
