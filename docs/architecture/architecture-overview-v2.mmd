flowchart LR
  %% Canonical authority map. Runtime jobs, route detail and physical data placement
  %% intentionally live in the companion views linked from design-architecture.md.

  USER["Automation / operator takeover<br/>single external wakeup"] --> ORCH

  subgraph CONTROL["Control and constraints"]
    direction TB
    ORCH["orchestration-ops<br/>cycle / job graph / health / incident / audit<br/>must not make trade or research decisions"]
    POLICY["policy-risk<br/>trading profile / mode / permissions / risk caps<br/>approved strategy refs / runtime policy"]
  end

  subgraph LIVE["Live trading authority chain"]
    direction TB
    MARKET["market-data-products<br/>market facts / canonical data / features / datasets<br/>must not emit trade actions"]
    EXCHANGE["exchange-gateway<br/>venue account / order / fill facts<br/>only owner of authorized venue side effects"]
    DECISION["live-decision-planning<br/>observe / thesis / plan / proposed capital allocation<br/>action intent; no venue write"]
    EXECUTION["live-execution-control<br/>fast guard / preflight / execute / confirm / recover<br/>no thesis or strategy promotion"]
    STATE["portfolio-execution-state<br/>trade events / flow and portfolio projections<br/>risk lock / reconcile state; rebuildable"]
  end

  subgraph EVIDENCE["Strategy and evidence authority chain"]
    direction TB
    RESEARCH["research-strategy-development<br/>hypothesis / Trial / Replay / Forward / RD state<br/>no live authorization or trade events"]
    GOVERNANCE["governance-review-compliance<br/>evidence intake / trade review / promotion decision<br/>policy feedback; no raw research search"]
    ARTIFACT["artifact-knowledge<br/>catalog / lineage / retention / GC<br/>no trading fact or strategy qualification"]
  end

  subgraph SHARED["Shared system contract planes — not business domains"]
    direction TB
    FABRIC["protocol fabric<br/>command / fact / intent / authorization / result / ref envelopes"]
    RUNTIME["domain runtime<br/>accept / handle / commit / outbox / failure semantics"]
    TRUST["trust and reliability<br/>identity / capability / freshness / idempotency / incident"]
  end

  ORCH -->|"targeted job ticket + refs"| DECISION
  ORCH -->|"targeted job ticket + refs"| EXECUTION
  ORCH -->|"targeted job ticket + refs"| RESEARCH
  ORCH -->|"targeted job ticket + refs"| GOVERNANCE
  ORCH -->|"targeted job ticket + refs"| ARTIFACT

  ORCH -->|"health / safe-mode facts"| POLICY
  POLICY -->|"runtime policy / profile-mode"| DECISION
  POLICY -->|"runtime policy / profile-mode"| EXECUTION
  POLICY -->|"authorized mode only"| EXCHANGE

  MARKET -->|"fresh market facts"| DECISION
  MARKET -->|"fresh guard facts"| EXECUTION
  MARKET -->|"dataset + lineage refs"| RESEARCH
  EXCHANGE -->|"account facts"| DECISION
  EXCHANGE -->|"account / order / fill facts"| EXECUTION
  STATE -->|"portfolio / flow projection refs"| DECISION
  STATE -->|"active flow / risk-lock refs"| EXECUTION

  DECISION -->|"action intent"| EXECUTION
  EXECUTION -->|"capability-bound exchange command"| EXCHANGE
  EXCHANGE -->|"submit / confirm / unknown result"| EXECUTION
  EXECUTION -->|"event / reconcile proposal"| STATE
  STATE -->|"closed-flow refs"| GOVERNANCE

  RESEARCH -->|"evidence / candidate refs"| GOVERNANCE
  GOVERNANCE -->|"promotion decision / scoped feedback"| RESEARCH
  GOVERNANCE -->|"policy feedback"| POLICY
  RESEARCH -->|"artifact + lineage registration"| ARTIFACT
  GOVERNANCE -->|"review artifact registration"| ARTIFACT
  DECISION -->|"observe / watch artifact registration"| ARTIFACT

  FABRIC -. "governs cross-domain envelopes" .-> ORCH
  FABRIC -. "governs cross-domain envelopes" .-> LIVE
  FABRIC -. "governs cross-domain envelopes" .-> EVIDENCE
  RUNTIME -. "governs domain ports" .-> CONTROL
  RUNTIME -. "governs domain ports" .-> LIVE
  RUNTIME -. "governs domain ports" .-> EVIDENCE
  TRUST -. "constrains every privileged route" .-> CONTROL
  TRUST -. "constrains every privileged route" .-> LIVE
  TRUST -. "constrains every privileged route" .-> EVIDENCE

  classDef control fill:#eaf4ff,stroke:#2f6fb0,color:#0b2540;
  classDef live fill:#fff7df,stroke:#b08a00,color:#3b3000;
  classDef evidence fill:#f2eefe,stroke:#7556b8,color:#241445;
  classDef shared fill:#f8fafc,stroke:#64748b,color:#334155,stroke-dasharray:4 3;
  class ORCH,POLICY control;
  class MARKET,EXCHANGE,DECISION,EXECUTION,STATE live;
  class RESEARCH,GOVERNANCE,ARTIFACT evidence;
  class FABRIC,RUNTIME,TRUST shared;
