flowchart TB
  %% Proposed remote single-host container runtime.
  %% This is a deployment/runtime view, not evidence that the profile is implemented.

  OP["Operator<br/>VPN / SSH tunnel / authenticated ingress"]
  CODEX["Codex development<br/>operator client / Host benchmark"]
  BPUB["Binance public APIs<br/>L2 WebSocket / OHLCV REST"]
  BPRIV["Binance private APIs<br/>account / order / fill / authorized write"]
  MODEL["SiliconFlow or replaceable model provider"]

  subgraph SERVER["Remote Linux server"]
    direction TB

    MGR["Docker Compose / container manager<br/>start · stop · restart · resource limits<br/>not business scheduler"]

    subgraph L2C["market-l2 container · Rust / Tokio · always-on"]
      direction LR
      L2START["foreground L2 owner"] --> L2WS["public WebSocket receive"]
      L2WS --> L2SEQ{"sequence continuous?"}
      L2SEQ -->|"yes"| BOOK["in-memory L2 book"]
      L2SEQ -->|"no"| RESYNC["gap / resync / new epoch"]
      RESYNC --> L2WS
      BOOK --> RAW["append raw segment<br/>epoch manifest"]
      BOOK --> L2READ["bounded current-book / watch port"]
      RAW --> L2COMPACT["bounded compaction / retention"]
    end

    subgraph CTRLC["trade-control container · TypeScript / Bun · always-on"]
      direction TB

      TICK["resident Program tick<br/>timer / event / recovery wake"] --> LEASE["acquire fenced cycle lease"]
      OPAPI["authenticated operator surface<br/>status / bounded lifecycle action"]
      LEASE --> HEALTH["owner health / freshness / safe-mode"]

      HEALTH --> DATA_DUE{"data maintenance due?"}
      DATA_DUE -->|"yes"| OHLCV["OHLCV sync / gap fill<br/>Market Data owner"]
      OHLCV --> FEATURE["indicator / feature refresh<br/>watermark-bound Go or Bun"]
      L2NEED["Market Data L2 demand coordinator<br/>candidate · active exposure · RD<br/>target gap: not implemented"]
      DATA_DUE -->|"no"| J01
      FEATURE --> J01

      J01["J01 account reconcile<br/>restore exchange facts / risk lock"] --> J02["J02 fast guard<br/>active flow only / defensive path"]
      J02 --> FORK["due-job fork"]
      FORK --> J03["J03 slow watch / plan<br/>setup · thesis · action intent"]
      FORK --> J04["J04 long-running R&D Factory wake<br/>plan next bounded durable step"]
      FORK --> J05["J05 Forward evidence"]
      FORK --> J06["J06 artifact / catalog hygiene"]

      J03 --> JOIN["typed result join"]
      J05 --> JOIN
      J06 --> JOIN
      J02 --> JOIN
      JOIN --> J07["J07 closed-flow review<br/>governance evidence"]
      J07 --> GOV["Governance lifecycle owner<br/>review · promote · pause · target retire"]
      GOV --> SUMMARY["cycle summary / incidents / notification"]
      SUMMARY --> WAIT["wait until next cadence"]
      WAIT --> TICK

      J04 --> RDPLAN{"R&D next step"}
      RDPLAN -->|"ready deterministic work"| REPLAY["Trial reservation + Replay owner"]
      RDPLAN -->|"semantic gap"| ARUN["Agent Run adapter<br/>submit · status · wait · cancel"]
      RDPLAN -->|"Campaign terminal / budget / dependency wait"| JOIN
      REPLAY --> RDRESULT["immutable Result / artifact refs"]
      RDRESULT --> RDPLAN
      RDPLAN -->|"accepted for draft"| REGISTRY["Strategy Registry<br/>deterministic Draft materialization"]
      REGISTRY --> J05
      REGISTRY -. "draft strategy ref" .-> GOV
      J05 -. "forward evidence ref" .-> GOV
      GOV -. "lifecycle evidence / improvement request" .-> RDPLAN

      J02 -. "active flow / order / position need" .-> L2NEED
      J03 -. "shortlisted candidate need" .-> L2NEED
      J04 -. "future capture need" .-> L2NEED

      J03 -. "registered semantic task only" .-> ARUN
      ARUN -->|"typed result"| ADMIT["owner validator / Control Plane admission"]
      ADMIT --> RDPLAN
      ADMIT -. "live decision proposal" .-> J03
      ARUN -->|"timeout / unavailable"| SEMBLOCK["blocked / retryable / no_action"]
      SEMBLOCK --> JOIN

      MCPNET["private Streamable HTTP MCP adapter"] --> ACL["capability allowlist<br/>auth · budget · idempotency · audit"]
      ACL --> OWNER["fixed owner ports / CLIs<br/>no duplicated business logic"]
      OWNER --> MCPNET

      EXOWNER["Exchange owner boundary<br/>read always · write separately authorized"]
      J01 --> EXOWNER
      J03 -. "fresh account refs" .-> EXOWNER
      J02 -. "confirmed active-flow facts" .-> EXOWNER
    end

    subgraph AGENTC["agent-host container · OpenClaw Gateway candidate · always-on but non-authoritative"]
      direction TB
      GATEWAY["authenticated Gateway WebSocket RPC"]
      PROFILE{"Agent runtime profile"}
      CODEXK["Codex App Server kernel<br/>preferred coding baseline"]
      ALTLOOP["OpenClaw alternate Agent loop<br/>separate bake-off profile"]
      MCPCLIENT["remote MCP client<br/>tool include/exclude filter"]
      LG["optional LangGraph JS<br/>inside one Agent Run, not a service"]
      HSTATE["Gateway / Codex thread / checkpoint / usage<br/>operational state only"]
      GATEWAY --> PROFILE
      PROFILE --> CODEXK
      PROFILE --> ALTLOOP
      LG -. "only for a proven local Run gap" .-> PROFILE
      CODEXK --> MCPCLIENT
      ALTLOOP --> MCPCLIENT
      CODEXK --> HSTATE
      ALTLOOP --> HSTATE
      HSTATE -. "resume context" .-> GATEWAY
    end

    subgraph SANDBOXC["Developer code-sandbox job · required before R&D Host adoption"]
      WORKTREE["frozen per-Run isolated worktree<br/>MD · implementation · tests"]
      PATCH["patch / test evidence / research artifact<br/>no secret · no owner DB · no default network"]
      WORKTREE --> PATCH
    end

    subgraph VOLUMES["separate persistent volumes"]
      OWNERDB["owner SQLite / governance / research state"]
      MARKETDB["OHLCV / feature / artifact refs"]
      L2VOL["L2 raw / epoch manifests"]
      HOSTVOL["Gateway / Codex operational state"]
    end

    OP -->|"status / approved lifecycle action"| OPAPI
    CODEX -. "VPN / SSH operator path" .-> OPAPI
    OPAPI -->|"wakeup / cancel / pause request"| TICK
    MGR -. "container lifecycle" .-> L2START
    MGR -. "container lifecycle" .-> TICK
    MGR -. "container lifecycle" .-> GATEWAY

    L2NEED -->|"admitted symbol needs; no daemon control"| L2START
    L2READ -->|"readiness / current facts"| L2NEED
    ARUN -->|"agent / agent.wait / cancel"| GATEWAY
    MCPCLIENT -->|"private MCP calls"| MCPNET
    MCPNET -->|"tool results"| MCPCLIENT
    CODEXK -->|"typed submission"| GATEWAY
    ALTLOOP -->|"typed submission"| GATEWAY
    GATEWAY -->|"terminal Agent Run result"| ARUN
    CODEXK -. "Developer profile" .-> WORKTREE
    ALTLOOP -. "Developer profile under comparison" .-> WORKTREE

    OWNER --> OWNERDB
    OHLCV --> MARKETDB
    FEATURE --> MARKETDB
    REPLAY --> OWNERDB
    REPLAY --> MARKETDB
    RAW --> L2VOL
    L2COMPACT --> L2VOL
    HSTATE --> HOSTVOL
  end

  BPUB --> L2WS
  BPUB --> OHLCV
  L2NEED -->|"ready refs"| J02
  L2NEED -->|"ready refs"| J03
  L2COMPACT -. "finalized historical source ref" .-> J04
  EXOWNER -->|"query / authorized command"| BPRIV
  BPRIV -->|"account / order / fill result"| EXOWNER
  CODEXK -->|"model request"| MODEL
  ALTLOOP -->|"model request"| MODEL
  MODEL -->|"stream / result"| CODEXK
  MODEL -->|"stream / result"| ALTLOOP

  SAFETY["Failure invariant<br/>Agent Host / MCP / model outage blocks only semantic work;<br/>L2, data maintenance, reconcile, risk and deterministic jobs keep running."]
  SEMBLOCK -.-> SAFETY
  HEALTH -.-> SAFETY

  classDef external fill:#f8fafc,stroke:#64748b,color:#334155;
  classDef hot fill:#fff1e8,stroke:#c45d17,color:#4a250d;
  classDef control fill:#eaf4ff,stroke:#2f6fb0,color:#0b2540;
  classDef agent fill:#f2eefe,stroke:#7556b8,color:#241445;
  classDef store fill:#eefbf3,stroke:#2d8a52,color:#123c25;
  classDef warning fill:#fff8df,stroke:#b08a00,color:#3b3000,stroke-dasharray:4 3;
  class OP,CODEX,BPUB,BPRIV,MODEL external;
  class L2START,L2WS,L2SEQ,BOOK,RESYNC,RAW,L2READ,L2COMPACT hot;
  class TICK,OPAPI,LEASE,HEALTH,DATA_DUE,OHLCV,FEATURE,L2NEED,J01,J02,FORK,J03,J04,J05,J06,JOIN,J07,GOV,SUMMARY,WAIT,RDPLAN,REPLAY,RDRESULT,REGISTRY,ARUN,ADMIT,MCPNET,ACL,OWNER,EXOWNER control;
  class GATEWAY,PROFILE,CODEXK,ALTLOOP,MCPCLIENT,LG,HSTATE agent;
  class OWNERDB,MARKETDB,L2VOL,HOSTVOL store;
  class SEMBLOCK,WORKTREE,PATCH,SAFETY warning;
