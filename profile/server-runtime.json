{
  "schema_version": "trade.server-runtime-profile.v1",
  "profile_id": "server-shadow",
  "deployment_id": "single-node-shadow",
  "l2_owner": {
    "symbol": "BTCUSDT",
    "output_base": "data/l2",
    "listen": "127.0.0.1:50061",
    "epoch_seconds": 86100,
    "queue_capacity": 256,
    "segment_frames": 1000,
    "sync_every_frames": 100,
    "stale_after_ms": 2000,
    "restart_limit": 8,
    "market_data_db": "data/market_data.db",
    "admission_interval_ms": 30000,
    "disk_check_interval_ms": 5000,
    "disk_soft_min_bytes": 10737418240,
    "disk_hard_min_bytes": 5368709120,
    "resource_check_interval_ms": 30000
  },
  "l2_consumer": {
    "max_cycles": 120,
    "session_ms": 300000,
    "max_events": 20,
    "watch_ms": 1000,
    "depth": 20,
    "max_freshness_ms": 1000,
    "restart_limit": 8
  },
  "control_runtime": {
    "trade_db": "data/trade.db",
    "ops_runtime_db": "data/ops_runtime.db",
    "interval_seconds": 60,
    "observe_agent_parity": true
  },
  "process_manager": {
    "target": "systemd",
    "service_user": "trade",
    "service_group": "trade",
    "restart_seconds": 5,
    "start_limit_burst": 5,
    "start_limit_interval_seconds": 60,
    "shutdown_grace_seconds": 45
  },
  "safety": {
    "domain_jobs_enabled": false,
    "live_writes_allowed": false,
    "notify_dry_run": true
  }
}
