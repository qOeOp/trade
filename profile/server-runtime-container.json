{
  "schema_version": "trade.server-runtime-container-profile.v1",
  "profile_id": "server-shadow-container",
  "deployment_id": "single-node-shadow-container",
  "market_data_runtime": {
    "market_data_db": "data/market_data.db",
    "ohlcv_db": "data/ohlcv.db",
    "l2": {
      "max_instances": 3,
      "base_port": 51100,
      "reconcile_interval_ms": 30000,
      "readiness_deadline_ms": 30000
    },
    "ohlcv_worker": {
      "max_symbols": 20,
      "max_jobs_per_cycle": 4,
      "max_rows_per_job": 10000,
      "interval_ms": 60000,
      "command_timeout_ms": 120000
    },
    "indicator_worker": {
      "max_symbols": 20,
      "max_jobs_per_cycle": 2,
      "max_bars": 50000,
      "interval_ms": 60000,
      "command_timeout_ms": 300000
    }
  },
  "control_runtime": {
    "trade_db": "data/trade.db",
    "ops_runtime_db": "data/ops/ops_runtime.db",
    "interval_seconds": 60,
    "observe_agent_parity": true
  },
  "shutdown_grace_seconds": 45,
  "safety": {
    "domain_jobs_enabled": false,
    "formal_replay_jobs_enabled": true,
    "live_writes_allowed": false,
    "notify_dry_run": true
  }
}
