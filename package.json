{
  "name": "trade-tooling",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "binance-api-node": "^0.13.9",
    "fflate": "^0.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "^1.3.5",
    "@types/node": "^26.1.1",
    "eslint": "10.8.0",
    "shellcheck": "4.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.65.0"
  },
  "scripts": {
    "check": "bun run lint && bun run check:secrets && bun run check:packages",
    "check:secrets": "bun run --cwd apps/orchestration-ops/agent-workspace-manager repository:secrets",
    "check:packages": "bun run --cwd apps/orchestration-ops/agent-workspace-manager repository:packages --run-all",
    "check:replay-release": "bun run --cwd apps/research-strategy-development/research-control-plane/certification/replay-release-audit audit",
    "lint": "eslint --max-warnings 0 .",
    "certify:replay": "bun run --cwd apps/research-strategy-development/replay-execution-plane/certification/replay-certification certify",
    "certify:replay:reproducibility": "bun apps/research-strategy-development/replay-execution-plane/certification/replay-certification/src/scripts/reproducibility.ts"
  }
}
