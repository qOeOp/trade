{
  "language": "research.strategy-authoring.v1",
  "inputs": [
    {"name": "open", "field": "OPEN"},
    {"name": "high", "field": "HIGH"},
    {"name": "low", "field": "LOW"},
    {"name": "close", "field": "CLOSE"}
  ],
  "definitions": [
    {"name": "prior_close", "expr": {"op": "AGO", "of": "close", "bars": 1}},
    {"name": "high_50", "expr": {"op": "MAX", "of": "prior_close", "window": 50}},
    {"name": "low_50", "expr": {"op": "MIN", "of": "prior_close", "window": 50}},
    {"name": "high_20", "expr": {"op": "MAX", "of": "prior_close", "window": 20}},
    {"name": "low_20", "expr": {"op": "MIN", "of": "prior_close", "window": 20}},
    {"name": "atr_20", "expr": {"op": "ATR", "period": 20}},
    {"name": "risk", "expr": {"op": "MUL", "a": "atr_20", "b": "2"}},
    {"name": "long_stop", "expr": {"op": "SUB", "a": "close", "b": "risk"}},
    {"name": "short_stop", "expr": {"op": "ADD", "a": "close", "b": "risk"}},
    {"name": "breaks_up", "expr": {"op": "COMPARE", "a": "close", "predicate": "GREATER", "b": "high_50"}},
    {"name": "breaks_down", "expr": {"op": "COMPARE", "a": "close", "predicate": "LESS", "b": "low_50"}},
    {"name": "long_channel_exit", "expr": {"op": "COMPARE", "a": "close", "predicate": "LESS", "b": "low_20"}},
    {"name": "short_channel_exit", "expr": {"op": "COMPARE", "a": "close", "predicate": "GREATER", "b": "high_20"}},
    {"name": "long_stop_touched", "expr": {"op": "COMPARE", "a": "low", "predicate": "LESS_OR_EQUAL", "b": "long_stop_level"}},
    {"name": "short_stop_touched", "expr": {"op": "COMPARE", "a": "high", "predicate": "GREATER_OR_EQUAL", "b": "short_stop_level"}},
    {"name": "held_too_long", "expr": {"op": "COMPARE", "a": "held", "predicate": "GREATER_OR_EQUAL", "b": "250"}},
    {"name": "in_position", "expr": {"op": "ANY_OF", "of": ["long", "short"]}},
    {"name": "flat", "expr": {"op": "NOT", "of": "in_position"}},
    {"name": "long_reverses", "expr": {"op": "ALL_OF", "of": ["long", "breaks_down"]}},
    {"name": "short_reverses", "expr": {"op": "ALL_OF", "of": ["short", "breaks_up"]}},
    {"name": "long_leaves", "expr": {"op": "ANY_OF", "of": ["long_channel_exit", "long_stop_touched"]}},
    {"name": "short_leaves", "expr": {"op": "ANY_OF", "of": ["short_channel_exit", "short_stop_touched"]}},
    {"name": "leave_long", "expr": {"op": "ALL_OF", "of": ["long", "long_leaves"]}},
    {"name": "leave_short", "expr": {"op": "ALL_OF", "of": ["short", "short_leaves"]}},
    {"name": "leave_on_time", "expr": {"op": "ALL_OF", "of": ["in_position", "held_too_long"]}},
    {"name": "exit_signal", "expr": {"op": "ANY_OF", "of": ["leave_long", "leave_short", "leave_on_time"]}},
    {"name": "long_signal", "expr": {"op": "ALL_OF", "of": ["flat", "breaks_up"]}},
    {"name": "short_signal", "expr": {"op": "ALL_OF", "of": ["flat", "breaks_down"]}},
    {"name": "opens_long", "expr": {"op": "ANY_OF", "of": ["flip_long", "enter_long"]}},
    {"name": "opens_short", "expr": {"op": "ANY_OF", "of": ["flip_short", "enter_short"]}},
    {"name": "closes_long", "expr": {"op": "ANY_OF", "of": ["flip_short", "exit"]}},
    {"name": "closes_short", "expr": {"op": "ANY_OF", "of": ["flip_long", "exit"]}},
    {"name": "opens", "expr": {"op": "ANY_OF", "of": ["opens_long", "opens_short"]}},
    {"name": "not_opening", "expr": {"op": "NOT", "of": "opens"}},
    {"name": "keeps_position", "expr": {"op": "ALL_OF", "of": ["in_position", "not_opening"]}}
  ],
  "states": [
    {"name": "long", "kind": {"kind": "LATCH", "set": "opens_long", "reset": "closes_long"}},
    {"name": "short", "kind": {"kind": "LATCH", "set": "opens_short", "reset": "closes_short"}},
    {"name": "held", "kind": {"kind": "COUNT_WHILE", "condition": "keeps_position"}},
    {"name": "long_stop_level", "kind": {"kind": "CAPTURE", "value": "long_stop", "when": "opens_long"}},
    {"name": "short_stop_level", "kind": {"kind": "CAPTURE", "value": "short_stop", "when": "opens_short"}}
  ],
  "rules": [
    {"name": "flip_short", "when": "long_reverses", "action": {"intent": "FLIP", "side": "SHORT", "units": 1}},
    {"name": "flip_long", "when": "short_reverses", "action": {"intent": "FLIP", "side": "LONG", "units": 1}},
    {"name": "exit", "when": "exit_signal", "action": {"intent": "EXIT"}},
    {"name": "enter_long", "when": "long_signal", "action": {"intent": "ENTER", "side": "LONG", "units": 1}},
    {"name": "enter_short", "when": "short_signal", "action": {"intent": "ENTER", "side": "SHORT", "units": 1}}
  ],
  "otherwise": {"intent": "HOLD"},
  "falsifier": "a close outside the prior 50 closes' range earns nothing over random entries with the same stop and exits"
}
