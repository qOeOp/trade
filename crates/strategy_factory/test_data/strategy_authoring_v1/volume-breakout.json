{
  "language": "research.strategy-authoring.v1",
  "inputs": [
    {"name": "close", "field": "CLOSE"},
    {"name": "volume", "field": "VOLUME"}
  ],
  "definitions": [
    {"name": "prior_close", "expr": {"op": "AGO", "of": "close", "bars": 1}},
    {"name": "high_20", "expr": {"op": "MAX", "of": "prior_close", "window": 20}},
    {"name": "low_10", "expr": {"op": "MIN", "of": "prior_close", "window": 10}},
    {"name": "prior_volume", "expr": {"op": "AGO", "of": "volume", "bars": 1}},
    {"name": "volume_high_20", "expr": {"op": "MAX", "of": "prior_volume", "window": 20}},
    {"name": "volume_ratio", "expr": {"op": "DIV", "a": "volume", "b": "volume_high_20"}},
    {"name": "heavy", "expr": {"op": "COMPARE", "a": "volume_ratio", "predicate": "GREATER", "b": "1.5"}},
    {"name": "breaks_up", "expr": {"op": "COMPARE", "a": "close", "predicate": "GREATER", "b": "high_20"}},
    {"name": "channel_exit", "expr": {"op": "COMPARE", "a": "close", "predicate": "LESS", "b": "low_10"}},
    {"name": "flat", "expr": {"op": "NOT", "of": "long"}},
    {"name": "leave", "expr": {"op": "ALL_OF", "of": ["long", "channel_exit"]}},
    {"name": "signal", "expr": {"op": "ALL_OF", "of": ["flat", "breaks_up", "heavy"]}}
  ],
  "states": [
    {"name": "long", "kind": {"kind": "LATCH", "set": "enter_long", "reset": "exit"}}
  ],
  "rules": [
    {"name": "exit", "when": "leave", "action": {"intent": "EXIT"}},
    {"name": "enter_long", "when": "signal", "action": {"intent": "ENTER", "side": "LONG", "units": 1}}
  ],
  "otherwise": {"intent": "HOLD"},
  "falsifier": "a close above the prior 20 closes on more than 1.5 times their heaviest volume earns nothing over the same breakout on any volume"
}
