# Reproduce the Linux development environment used for local verification.

FROM public.ecr.aws/docker/library/rust:1.97.1-slim-bookworm@sha256:99e09cb2284e2ddbb73a995deee3e91783fd04d177602ccf6eab326d778ee777 AS rust-toolchain

FROM public.ecr.aws/docker/library/ubuntu@sha256:962f6cadeae0ea6284001009daa4cc9a8c37e75d1f5191cf0eb83fe565b63dd7

ENV DEBIAN_FRONTEND=noninteractive
ENV RUST_BACKTRACE=1
ENV CARGO_INCREMENTAL=0
ENV CC="clang"
ENV CXX="clang++"

RUN apt-get update && apt-get install -y \
    curl \
    clang \
    lld \
    git \
    pkg-config \
    make \
    capnproto \
    libcapnp-dev \
    patchelf \
    gcc-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
ENV CARGO_HOME="/usr/local/cargo" \
    RUSTUP_HOME="/usr/local/rustup" \
    PATH="/usr/local/cargo/bin:${PATH}"

WORKDIR /workspace

COPY --from=ghcr.io/astral-sh/uv:0.12.1@sha256:cf4eedcaa81655197f625739489effcbe71b61ceb1506f332c3facae5deceded \
  /uv /uvx /root/.local/bin/
ENV PATH="/root/.local/bin:${PATH}"

RUN uv python install 3.13

COPY scripts/rust-toolchain.sh scripts/
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./

RUN bash scripts/rust-toolchain.sh > /tmp/toolchain.txt && \
    TOOLCHAIN=$(cat /tmp/toolchain.txt) && \
    rustup toolchain install "$TOOLCHAIN" && \
    rustup default "$TOOLCHAIN" && \
    rustup component add clippy rustfmt

COPY .docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
