{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.rd-supervisor-run-result.v1",
  "title": "trade-flow R&D supervisor run result",
  "description": "Stable outer shape for the autonomous R&D supervisor loop. Iteration internals remain intentionally open.",
  "type": "object",
  "required": ["schema_version", "state_ref", "started_at", "stopped_at", "status", "stop_reason", "iterations", "final_state", "guardrails"],
  "properties": {
    "schema_version": { "const": "trade-flow.rd-supervisor-run-result.v1" },
    "state_ref": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "stopped_at": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["strategy_draft_created", "shadow_candidate_found", "budget_exhausted", "data_or_tool_blocked", "iteration_limit_reached", "stopped"]
    },
    "stop_reason": { "type": "string", "minLength": 1 },
    "strategy_ref": { "type": "string", "minLength": 1 },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["iteration", "plan_id", "plan_status", "command", "reason", "state_status"],
        "properties": {
          "iteration": { "type": "integer", "minimum": 1 },
          "plan_id": { "type": "string", "minLength": 1 },
          "plan_status": { "enum": ["ready", "blocked", "stopped"] },
          "command": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 },
          "result_ref": { "type": "string" },
          "result_status": { "type": "string" },
          "state_status": { "type": "string", "minLength": 1 },
          "error": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "final_state": {
      "type": "object",
      "required": ["schema_version", "program_id", "objective", "status", "budget", "usage", "guardrails"],
      "properties": {
        "schema_version": { "const": "trade-flow.rd-program-state.v1" },
        "program_id": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "shadow_candidate_found", "budget_exhausted", "data_or_tool_blocked", "paused"] },
        "budget": { "type": "object" },
        "usage": { "type": "object" },
        "guardrails": {
          "type": "object",
          "required": ["may_write_trade_db", "may_call_binance_write", "evidence_status"],
          "properties": {
            "may_write_trade_db": { "const": false },
            "may_call_binance_write": { "const": false },
            "evidence_status": { "const": "research_memory_not_strategy_evidence" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "guardrails": {
      "type": "object",
      "required": ["may_write_trade_db", "may_call_binance_write", "evidence_status"],
      "properties": {
        "may_write_trade_db": { "const": false },
        "may_call_binance_write": { "const": false },
        "evidence_status": { "const": "research_memory_not_strategy_evidence" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
