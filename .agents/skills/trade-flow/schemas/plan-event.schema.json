{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.plan-event.v1",
  "title": "trade-flow plan_event row",
  "description": "Stable outer shape for local append-only plan_event rows. The body_json payload is kind-specific and intentionally unconstrained here.",
  "type": "object",
  "required": ["event_key", "chain_id", "kind", "body_json", "created_at"],
  "properties": {
    "event_key": {
      "type": "string",
      "minLength": 1
    },
    "chain_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["observe", "order_fill", "review"]
    },
    "body_json": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
