{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.track-dry-run-summary.v1",
  "title": "trade-flow track dry-run summary",
  "description": "Stable outer shape for slow/fast track dry-run results. Workflow-specific diagnostics remain intentionally open.",
  "type": "object",
  "required": ["track", "mode", "executable"],
  "properties": {
    "track": {
      "enum": ["slow", "fast"]
    },
    "mode": {
      "enum": ["dry-run", "analysis-only", "workflow-dry-run"]
    },
    "executable": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "active_flow_count": {
      "type": "integer",
      "minimum": 0
    },
    "lane_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lane_key", "chain_ids"],
        "properties": {
          "lane_key": {
            "type": "string"
          },
          "chain_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "active_flows": {
      "type": "array"
    },
    "planned_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflow_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "live_execution_allowed": {
      "type": "boolean"
    },
    "trade_decision": {
      "type": "object"
    },
    "skipped": {
      "type": "boolean"
    },
    "skip_reason": {
      "type": "string",
      "minLength": 1
    },
    "active_lock": {
      "type": ["object", "null"]
    },
    "cron_log_path": {
      "type": "string",
      "minLength": 1
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
