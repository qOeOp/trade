{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.reconcile-result.v1",
  "title": "trade-flow reconcile result",
  "description": "Stable outer shape for reconcile results. Drafts are local plan_event rows; unmatched item internals remain diagnostic and are intentionally unconstrained.",
  "type": "object",
  "required": ["chain_id", "compared_at", "can_reconcile", "drafts", "unmatched"],
  "properties": {
    "chain_id": {
      "type": "string",
      "minLength": 1
    },
    "compared_at": {
      "type": "string",
      "minLength": 1
    },
    "can_reconcile": {
      "type": "boolean"
    },
    "drafts": {
      "type": "array",
      "items": {
        "$ref": "plan-event.schema.json"
      }
    },
    "unmatched": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
