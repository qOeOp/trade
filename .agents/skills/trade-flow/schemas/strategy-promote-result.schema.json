{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.strategy-promote-result.v1",
  "title": "trade-flow strategy promote result",
  "description": "Stable outer shape for strategy promotion results. The nested report follows strategy-review-report; promotion diagnostics remain owned by the review gate.",
  "type": "object",
  "required": ["status", "from_status", "to_status", "report"],
  "properties": {
    "status": {
      "enum": ["dry-run", "updated"]
    },
    "from_status": {
      "type": "string",
      "minLength": 1
    },
    "to_status": {
      "enum": ["draft", "shadow", "live-small", "paused"]
    },
    "report": {
      "$ref": "strategy-review-report.schema.json"
    },
    "updated_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
