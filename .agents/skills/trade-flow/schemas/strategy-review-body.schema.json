{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.strategy-review-body.v1",
  "title": "trade-flow strategy review body",
  "description": "Stable minimum body contract for structured strategy review events. Extra attribution fields may evolve.",
  "type": "object",
  "required": ["strategy_ref", "outcome", "thesis_held", "key_lesson", "promote_to_strategy"],
  "properties": {
    "strategy_ref": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": ["win", "loss", "breakeven", "scratch"]
    },
    "r": {
      "type": "number"
    },
    "pnl_r": {
      "type": "number"
    },
    "pnl_R": {
      "type": "number"
    },
    "pnl_pct": {
      "type": "number"
    },
    "thesis_held": {
      "type": "boolean"
    },
    "key_lesson": {
      "type": "string",
      "minLength": 1
    },
    "promote_to_strategy": {
      "type": "boolean"
    }
  },
  "anyOf": [
    { "required": ["r"] },
    { "required": ["pnl_r"] },
    { "required": ["pnl_R"] },
    { "required": ["pnl_pct"] }
  ]
}
