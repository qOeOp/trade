{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.exchange.account-facts.v1",
  "type": "object",
  "required": [
    "schema_version",
    "account_ref",
    "account_scope",
    "venue",
    "environment",
    "market",
    "as_of",
    "source",
    "freshness",
    "equity_usdt",
    "available_margin_usdt",
    "positions",
    "open_orders",
    "content_hash",
    "snapshot_ref"
  ],
  "properties": {
    "schema_version": { "const": "trade.exchange.account-facts.v1" },
    "account_ref": { "type": "string", "minLength": 1 },
    "account_scope": { "type": "string", "minLength": 1 },
    "venue": { "const": "binance" },
    "environment": { "const": "live" },
    "market": { "const": "usdm" },
    "as_of": { "type": "string", "format": "date-time" },
    "source": { "const": "binance.futures.account-snapshot" },
    "freshness": {
      "type": "object",
      "required": ["observed_at", "max_age_seconds"],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "max_age_seconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "can_trade": { "type": "boolean" },
    "equity_usdt": { "type": "number" },
    "wallet_balance_usdt": { "type": "number" },
    "available_margin_usdt": { "type": "number" },
    "unrealized_pnl_usdt": { "type": "number" },
    "balances": { "type": "array" },
    "positions": { "type": "array" },
    "open_orders": {
      "type": "object",
      "required": ["regular", "protective"],
      "properties": {
        "regular": { "type": "array" },
        "protective": { "type": "array" }
      },
      "additionalProperties": false
    },
    "source_errors": { "type": "object" },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "snapshot_ref": { "type": "string", "pattern": "^exchange-account-facts://" }
  },
  "additionalProperties": false
}
