{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.replay-result.v1",
  "title": "trade-flow replay result",
  "description": "Stable outer shape for mechanical replay results. Trade rows, assumptions, and provenance internals remain shallow.",
  "type": "object",
  "required": ["strategy_id", "symbol", "timeframe", "sample_count", "win_rate", "avg_r", "total_r", "max_drawdown_r", "profit_factor", "expectancy_r", "gate", "trades", "assumptions", "provenance", "notes"],
  "properties": {
    "strategy_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "timeframe": { "type": "string", "minLength": 1 },
    "sample_count": { "type": "integer", "minimum": 0 },
    "win_rate": { "type": "number" },
    "avg_r": { "type": "number" },
    "total_r": { "type": "number" },
    "max_drawdown_r": { "type": "number" },
    "profit_factor": { "type": "number" },
    "expectancy_r": { "type": "number" },
    "gate": {
      "type": "object",
      "required": ["shadow_candidate", "live_small_candidate", "blocked_by"],
      "properties": {
        "shadow_candidate": { "type": "boolean" },
        "live_small_candidate": { "const": false },
        "blocked_by": { "type": "array" }
      }
    },
    "trades": { "type": "array" },
    "assumptions": { "type": "object" },
    "provenance": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
