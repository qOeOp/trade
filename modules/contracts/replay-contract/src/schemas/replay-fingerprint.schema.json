{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.replay-fingerprint.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["harness_hash"],
  "properties": {
    "harness_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assumptions_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
