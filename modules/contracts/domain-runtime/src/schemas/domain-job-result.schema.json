{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.domain-runtime.domain-job-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "ok",
    "status",
    "domain",
    "job_id",
    "idempotency_key",
    "input_refs",
    "output_refs",
    "writes",
    "incidents",
    "audit"
  ],
  "properties": {
    "schema_id": { "const": "trade.domain-runtime.domain-job-result.v1" },
    "ok": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["ok", "skipped", "blocked", "failed", "retryable", "needs_review"]
    },
    "domain": {
      "type": "string",
      "enum": [
        "orchestration-ops",
        "policy-risk",
        "portfolio-execution-state",
        "market-data-products",
        "exchange-gateway",
        "live-decision-planning",
        "live-execution-control",
        "research-strategy-development",
        "governance-review-compliance",
        "artifact-knowledge"
      ]
    },
    "job_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "input_refs": { "type": "array", "items": { "type": "string" } },
    "output_refs": { "type": "array", "items": { "type": "string" } },
    "writes": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "incidents": { "type": "array", "items": { "type": "string" } },
    "audit": { "type": "object", "additionalProperties": true }
  }
}
