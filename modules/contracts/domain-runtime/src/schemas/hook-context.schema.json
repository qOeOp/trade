{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.domain-runtime.hook-context.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "domain", "job_id", "hook", "idempotency_key"],
  "properties": {
    "schema_id": { "const": "trade.domain-runtime.hook-context.v1" },
    "domain": {
      "type": "string",
      "enum": [
        "orchestration-ops",
        "policy-risk",
        "portfolio-execution-state",
        "market-data-products",
        "exchange-gateway",
        "live-decision-planning",
        "live-execution-control",
        "research-strategy-development",
        "governance-review-compliance",
        "artifact-knowledge"
      ]
    },
    "job_id": { "type": "string", "minLength": 1 },
    "ticket_no": { "type": "string", "pattern": "^J[0-9]{2}$" },
    "stage": { "type": "string", "minLength": 1 },
    "hook": {
      "type": "string",
      "enum": ["pre_accept", "pre_handle", "handler", "post_handle", "post_commit", "outbox", "on_error"]
    },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "input_refs": { "type": "array", "items": { "type": "string" } },
    "allowed_writes": { "type": "array", "items": { "type": "string" } },
    "trading_mode_ref": { "type": "string" },
    "audit": { "type": "object", "additionalProperties": true }
  }
}
