{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.protocol.job-ticket.v1",
  "title": "protocol fabric job ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "tool_id", "target_domain", "module_type", "capability_class", "writes", "concurrency_group", "payload", "entry_contract", "command_spec"],
  "properties": {
    "job_id": { "type": "string", "minLength": 1 },
    "ticket_no": { "type": "string", "pattern": "^J[0-9]{2}$" },
    "tool_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "target_domain": {
      "type": "string",
      "enum": [
        "orchestration-ops",
        "policy-risk",
        "portfolio-execution-state",
        "market-data-products",
        "exchange-gateway",
        "live-decision-planning",
        "live-execution-control",
        "research-strategy-development",
        "governance-review-compliance",
        "artifact-knowledge"
      ]
    },
    "handler_tool_id": { "type": "string", "minLength": 1 },
    "module_type": { "type": "string", "enum": ["suite", "atomic", "contract"] },
    "capability_class": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["R", "A", "E", "V", "T", "C"] }
    },
    "writes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_db", "catalog", "artifacts", "binance", "config"],
      "properties": {
        "trade_db": { "type": "boolean" },
        "catalog": { "type": "boolean" },
        "artifacts": { "type": "boolean" },
        "binance": { "type": "boolean" },
        "config": { "type": "boolean" }
      }
    },
    "concurrency_group": { "type": "string", "minLength": 1 },
    "requires_preflight": { "type": "boolean", "default": false },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "result_ref"],
        "properties": {
          "tool_id": { "type": "string", "minLength": 1 },
          "result_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "input_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stop_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "handoff_summary": { "type": "string" },
    "payload": {
      "oneOf": [
        { "type": "object" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "entry_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input_schema", "output_schema"],
      "properties": {
        "kind": { "type": "string", "enum": ["cli-json"] },
        "input_schema": { "type": "string" },
        "output_schema": { "type": "string" }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "output_schema"],
      "properties": {
        "kind": { "type": "string", "enum": ["cli-json", "artifact-ref", "event-draft", "notify"] },
        "output_schema": { "type": "string" }
      }
    },
    "command_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "cwd", "argv"],
      "properties": {
        "executable": { "type": "boolean" },
        "cwd": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
