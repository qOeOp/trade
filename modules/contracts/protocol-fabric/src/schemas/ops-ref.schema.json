{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.protocol.ops-ref.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "kind"],
  "properties": {
    "ref": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["runtime_health", "incident", "cycle_summary", "next_cycle_constraint", "notify_attempt"]
    },
    "cycle_id": { "type": "string" },
    "severity": { "type": "string" }
  }
}
