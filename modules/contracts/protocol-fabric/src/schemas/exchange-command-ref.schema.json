{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.protocol.exchange-command-ref.v1",
  "title": "protocol fabric exchange command ref",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_ref", "client_order_id", "action", "status", "idempotency_key"],
  "properties": {
    "schema_version": { "const": "trade.protocol.exchange-command-ref.v1" },
    "command_ref": { "type": "string", "minLength": 1 },
    "client_order_id": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "enum": ["place_entry", "adjust_position", "cancel_order", "sync_protection", "reduce_position", "close_position"] },
    "status": { "type": "string", "enum": ["planned", "submitted", "accepted", "rejected", "confirmed", "unknown"] },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "request_ref": { "type": "string" },
    "result_ref": { "type": "string" },
    "exchange_order_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_intent_ref": { "type": "string" },
    "event_write_ref": { "type": "string" },
    "capability_ref": { "type": "string" }
  }
}
