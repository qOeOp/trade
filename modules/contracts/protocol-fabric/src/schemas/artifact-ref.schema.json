{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.protocol.artifact-ref.v1",
  "title": "protocol fabric artifact ref",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_ref", "owner_domain", "content_hash", "created_at"],
  "properties": {
    "schema_version": { "const": "trade.protocol.artifact-ref.v1" },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "owner_domain": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "minLength": 1 },
    "schema_id": { "type": "string" },
    "created_at": { "type": "string", "minLength": 1 },
    "retention": { "type": "string", "enum": ["ephemeral", "pinned", "evidence", "audit"] },
    "lineage_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
