{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.protocol.policy-snapshot.v1",
  "title": "protocol fabric policy snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_ref", "policy_hash", "generated_at", "approved_strategy_refs"],
  "properties": {
    "schema_version": { "const": "trade.protocol.policy-snapshot.v1" },
    "policy_ref": { "type": "string", "minLength": 1 },
    "policy_hash": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "approved_strategy_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risk_limits_ref": { "type": "string" },
    "cost_model_ref": { "type": "string" },
    "input_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
