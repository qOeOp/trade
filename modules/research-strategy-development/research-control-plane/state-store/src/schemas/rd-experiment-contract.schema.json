{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.rd-experiment-contract.v3",
  "type": "object",
  "required": [
    "schema_version", "canonical_node_id", "code_family_id", "implementation_version",
    "contract_versions", "hypothesis", "economic_rationale", "asset_universe_definition",
    "timeframe", "sampling_and_alignment", "required_data", "feature_definition",
    "target_definition", "forecast_definition", "signal_definition", "position_rule",
    "portfolio_construction", "risk_rule", "execution_rule", "transaction_cost_model",
    "expected_holding_period", "benchmark", "validation_plan", "rejection_criteria",
    "trial_group_ref", "candidate_registration", "parent_experiment_id", "random_seed",
    "code_commit_ref", "harness_commit_ref", "data_snapshot_ref", "assumptions_ref",
    "replay_execution_input"
  ],
  "properties": {
    "schema_version": { "const": "trade-flow.rd-experiment-contract.v3" },
    "canonical_node_id": { "type": "string", "minLength": 1 },
    "code_family_id": { "type": "string", "minLength": 1 },
    "implementation_version": { "type": "string", "minLength": 1 },
    "contract_versions": {
      "type": "object",
      "required": ["identity_hash_policy", "validator", "lifecycle_rule", "scope_policy"],
      "properties": {
        "identity_hash_policy": { "type": "string", "minLength": 1 },
        "validator": { "type": "string", "minLength": 1 },
        "lifecycle_rule": { "type": "string", "minLength": 1 },
        "scope_policy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "hypothesis": { "type": "object" },
    "economic_rationale": { "type": "object", "minProperties": 1 },
    "asset_universe_definition": { "type": "object" },
    "timeframe": { "type": "object" },
    "sampling_and_alignment": { "type": "object" },
    "required_data": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "feature_definition": { "type": "object" },
    "target_definition": { "type": "object" },
    "forecast_definition": { "type": "object" },
    "signal_definition": { "type": "object" },
    "position_rule": { "type": "object" },
    "portfolio_construction": { "type": "object" },
    "risk_rule": { "type": "object" },
    "execution_rule": { "type": "object" },
    "transaction_cost_model": { "type": "object" },
    "expected_holding_period": { "type": "object" },
    "benchmark": { "type": "object" },
    "validation_plan": { "type": "object" },
    "rejection_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "trial_group_ref": {
      "type": "object",
      "required": ["trial_group_id", "group_hash"],
      "properties": {
        "trial_group_id": { "type": "string", "minLength": 1 },
        "group_hash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "candidate_registration": {
      "type": "object",
      "required": ["candidate_ids"],
      "properties": {
        "candidate_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "parent_experiment_id": { "type": ["string", "null"] },
    "random_seed": { "type": "integer" },
    "code_commit_ref": { "type": "string", "minLength": 1 },
    "harness_commit_ref": { "type": "string", "minLength": 1 },
    "data_snapshot_ref": { "type": "string", "minLength": 1 },
    "assumptions_ref": { "type": "string", "minLength": 1 },
    "replay_execution_input": {
      "type": "object",
      "required": ["supplemental_requirement_set_schema_version", "supplemental_requirement_set_hash"],
      "properties": {
        "supplemental_requirement_set_schema_version": { "const": "trade.rd-replay-supplemental-requirement-set.v1" },
        "supplemental_requirement_set_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
