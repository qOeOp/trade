{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.rd-data-split-segment-snapshot.v1",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_ref",
    "split_id",
    "hypothesis_id",
    "dataset_id",
    "symbol",
    "segment",
    "timeframe",
    "row_count",
    "first_open_at",
    "last_open_at",
    "report_ref",
    "report_hash",
    "manifest_ref",
    "manifest_hash",
    "content_ref",
    "content_hash",
    "snapshot_hash"
  ],
  "properties": {
    "schema_version": { "const": "trade.rd-data-split-segment-snapshot.v1" },
    "snapshot_ref": { "type": "string", "minLength": 1 },
    "split_id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "segment": { "enum": ["discovery", "validation"] },
    "timeframe": { "type": "string", "minLength": 1 },
    "row_count": { "type": "integer", "minimum": 1 },
    "first_open_at": { "type": "string", "format": "date-time" },
    "last_open_at": { "type": "string", "format": "date-time" },
    "report_ref": { "type": "string", "minLength": 1 },
    "report_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifest_ref": { "type": "string", "minLength": 1 },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "content_ref": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
