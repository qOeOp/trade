{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.strategy-hypothesis-contract.v1",
  "title": "trade-flow strategy hypothesis contract",
  "type": "object",
  "required": [
    "schema_version",
    "hypothesis_id",
    "title",
    "return_driver",
    "portfolio_shape",
    "data_surfaces",
    "thesis",
    "trade_logic",
    "evidence_plan",
    "compilation"
  ],
  "properties": {
    "schema_version": { "const": "trade-flow.strategy-hypothesis-contract.v1" },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "return_driver": { "type": "string", "minLength": 1 },
    "portfolio_shape": { "type": "string", "minLength": 1 },
    "data_surfaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "thesis": { "type": "object" },
    "universe": { "type": "object" },
    "trade_logic": { "type": "object" },
    "risk": { "type": "object" },
    "evidence_plan": { "type": "object" },
    "data_binding": { "type": "object" },
    "compilation": { "type": "object" },
    "constraints": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
