{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.strategy-data-split-result.v1",
  "title": "trade-flow strategy data split result",
  "description": "Stable outer shape for pre-R&D discovery / validation / locked holdout manifest splits.",
  "type": "object",
  "required": [
    "schema_version",
    "split_id",
    "hypothesis_id",
    "generated_at",
    "timeframe",
    "output_root",
    "ratios",
    "embargo",
    "dataset_count",
    "datasets",
    "guardrails"
  ],
  "properties": {
    "schema_version": { "const": "trade-flow.strategy-data-split.v1" },
    "split_id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string" },
    "generated_at": { "type": "string", "minLength": 1 },
    "timeframe": { "type": "string", "minLength": 1 },
    "output_root": { "type": "string", "minLength": 1 },
    "ratios": { "type": "object" },
    "embargo": { "type": "object" },
    "dataset_count": { "type": "integer", "minimum": 1 },
    "datasets": { "type": "array", "minItems": 1 },
    "guardrails": { "type": "object" },
    "report_path": { "type": "string", "minLength": 1 },
    "catalog_db_path": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
