{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.l2-segment.v1",
  "$defs": {
    "write_result": {
      "type": "object",
      "required": ["schema_version", "implementation", "frame_count", "payload_bytes", "segment_bytes", "payload_hash", "segment_hash", "elapsed_ns"],
      "properties": {
        "schema_version": { "const": "trade.l2-segment-write-result.v1" },
        "implementation": { "enum": ["bun", "go", "rust"] },
        "frame_count": { "type": "integer", "minimum": 1 },
        "payload_bytes": { "type": "integer", "minimum": 1 },
        "segment_bytes": { "type": "integer", "minimum": 17 },
        "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "segment_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "elapsed_ns": { "type": "integer", "minimum": 0 }
      }
    },
    "recovery_result": {
      "type": "object",
      "required": ["schema_version", "implementation", "status", "valid_frame_count", "valid_bytes", "payload_bytes", "payload_hash", "segment_bytes", "elapsed_ns"],
      "properties": {
        "schema_version": { "const": "trade.l2-segment-recovery-result.v1" },
        "implementation": { "enum": ["bun", "go", "rust"] },
        "status": { "enum": ["complete", "invalid_header", "truncated_frame_header", "invalid_length", "truncated_payload", "checksum_mismatch"] },
        "valid_frame_count": { "type": "integer", "minimum": 0 },
        "valid_bytes": { "type": "integer", "minimum": 0 },
        "payload_bytes": { "type": "integer", "minimum": 0 },
        "payload_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "segment_bytes": { "type": "integer", "minimum": 0 },
        "elapsed_ns": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
