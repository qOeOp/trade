{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.l2-natural-soak-supervisor-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "symbol",
    "requested_duration_seconds",
    "minimum_gate_duration_seconds",
    "sample_interval_ms",
    "gate_eligible",
    "gate_verdict",
    "checks",
    "worker",
    "segment_verification",
    "resources",
    "resource_samples"
  ],
  "properties": {
    "schema_version": {
      "const": "trade.l2-natural-soak-supervisor-evidence.v1"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9]{5,20}$" },
    "requested_duration_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 86400
    },
    "minimum_gate_duration_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 86400
    },
    "sample_interval_ms": {
      "type": "integer",
      "minimum": 250,
      "maximum": 60000
    },
    "gate_eligible": { "type": "boolean" },
    "gate_verdict": { "enum": ["passed", "failed", "ineligible"] },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_schema_valid",
        "symbol_matches",
        "duration_matches",
        "natural_disconnect_mode",
        "worker_passed",
        "duration_completed",
        "events_recorded",
        "bounded_queue_respected",
        "all_segments_verified"
      ],
      "properties": {
        "worker_schema_valid": { "type": "boolean" },
        "symbol_matches": { "type": "boolean" },
        "duration_matches": { "type": "boolean" },
        "natural_disconnect_mode": { "type": "boolean" },
        "worker_passed": { "type": "boolean" },
        "duration_completed": { "type": "boolean" },
        "events_recorded": { "type": "boolean" },
        "bounded_queue_respected": { "type": "boolean" },
        "all_segments_verified": { "type": "boolean" }
      }
    },
    "worker": { "$ref": "#/$defs/worker" },
    "segment_verification": { "$ref": "#/$defs/segmentVerification" },
    "resources": { "$ref": "#/$defs/resources" },
    "resource_samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resourceSample" }
    }
  },
  "$defs": {
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "exit_code",
        "evidence_path",
        "verdict",
        "elapsed_ms",
        "connection_count",
        "resync_count",
        "total_received_messages",
        "total_recorded_events",
        "total_segments",
        "max_queue_depth",
        "queue_capacity",
        "p95_event_lag_ms",
        "max_event_lag_ms",
        "incident_count",
        "incident_kinds"
      ],
      "properties": {
        "pid": { "type": "integer", "minimum": 2 },
        "exit_code": { "const": 0 },
        "evidence_path": { "type": "string", "minLength": 1 },
        "verdict": { "const": "passed" },
        "elapsed_ms": { "type": "integer", "minimum": 1 },
        "connection_count": { "type": "integer", "minimum": 1 },
        "resync_count": { "type": "integer", "minimum": 0 },
        "total_received_messages": { "type": "integer", "minimum": 1 },
        "total_recorded_events": { "type": "integer", "minimum": 1 },
        "total_segments": { "type": "integer", "minimum": 1 },
        "max_queue_depth": { "type": "integer", "minimum": 0 },
        "queue_capacity": { "type": "integer", "minimum": 1 },
        "p95_event_lag_ms": { "type": "integer", "minimum": 0 },
        "max_event_lag_ms": { "type": "integer", "minimum": 0 },
        "incident_count": { "type": "integer", "minimum": 0 },
        "incident_kinds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "segmentVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_segments",
        "verified_complete_segments",
        "all_complete"
      ],
      "properties": {
        "declared_segments": { "type": "integer", "minimum": 1 },
        "verified_complete_segments": { "type": "integer", "minimum": 1 },
        "all_complete": { "const": true }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "initial_rss_bytes",
        "final_rss_bytes",
        "min_rss_bytes",
        "max_rss_bytes",
        "p95_rss_bytes",
        "head_median_rss_bytes",
        "tail_median_rss_bytes",
        "tail_minus_head_rss_bytes",
        "mean_cpu_percent",
        "p95_cpu_percent",
        "max_cpu_percent"
      ],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1 },
        "initial_rss_bytes": { "type": "integer", "minimum": 1 },
        "final_rss_bytes": { "type": "integer", "minimum": 1 },
        "min_rss_bytes": { "type": "integer", "minimum": 1 },
        "max_rss_bytes": { "type": "integer", "minimum": 1 },
        "p95_rss_bytes": { "type": "integer", "minimum": 1 },
        "head_median_rss_bytes": { "type": "integer", "minimum": 1 },
        "tail_median_rss_bytes": { "type": "integer", "minimum": 1 },
        "tail_minus_head_rss_bytes": { "type": "integer" },
        "mean_cpu_percent": { "type": "number", "minimum": 0 },
        "p95_cpu_percent": { "type": "number", "minimum": 0 },
        "max_cpu_percent": { "type": "number", "minimum": 0 }
      }
    },
    "resourceSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_ms", "rss_bytes", "cpu_percent"],
      "properties": {
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "rss_bytes": { "type": "integer", "minimum": 1 },
        "cpu_percent": { "type": "number", "minimum": 0 }
      }
    }
  }
}
