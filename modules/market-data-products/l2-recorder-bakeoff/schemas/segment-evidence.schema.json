{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.l2-segment-bakeoff-evidence.v1",
  "type": "object",
  "required": ["schema_version", "generated_at", "fixture", "frame_count", "samples_per_implementation", "write_parity", "recovery_parity", "implementations"],
  "properties": {
    "schema_version": { "const": "trade.l2-segment-bakeoff-evidence.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "fixture": { "type": "string" },
    "frame_count": { "type": "integer", "minimum": 1 },
    "samples_per_implementation": { "type": "integer", "minimum": 1 },
    "write_parity": { "type": "object" },
    "recovery_parity": { "type": "object" },
    "implementations": { "type": "array", "minItems": 3, "maxItems": 3 }
  }
}
