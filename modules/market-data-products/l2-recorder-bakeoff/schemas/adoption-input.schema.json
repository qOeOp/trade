{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade.l2-runtime-adoption-input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness",
    "checks",
    "candidates",
    "relative_to_bun",
    "generated_at",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": "trade.l2-runtime-adoption-input.v1" },
    "readiness": {
      "enum": [
        "awaiting_natural_soak",
        "ready_for_adoption_decision",
        "evidence_failed"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projector_schema",
        "projector_parity",
        "segment_schema",
        "segment_byte_parity",
        "crash_schema",
        "crash_recovery_parity",
        "supervised_soak_schema",
        "supervised_kill_restart",
        "natural_soak_present",
        "natural_soak_passed"
      ],
      "properties": {
        "projector_schema": { "type": "boolean" },
        "projector_parity": { "type": "boolean" },
        "segment_schema": { "type": "boolean" },
        "segment_byte_parity": { "type": "boolean" },
        "crash_schema": { "type": "boolean" },
        "crash_recovery_parity": { "type": "boolean" },
        "supervised_soak_schema": { "type": "boolean" },
        "supervised_kill_restart": { "type": "boolean" },
        "natural_soak_present": { "type": "boolean" },
        "natural_soak_passed": { "type": "boolean" }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["implementation", "projector", "segment_writer"],
        "properties": {
          "implementation": { "enum": ["bun", "go", "rust"] },
          "projector": { "$ref": "#/$defs/projector" },
          "segment_writer": { "$ref": "#/$defs/segmentWriter" }
        }
      }
    },
    "relative_to_bun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rust_projector_median_latency_ratio",
        "rust_projector_rss_ratio",
        "rust_segment_median_latency_ratio",
        "rust_segment_rss_ratio"
      ],
      "properties": {
        "rust_projector_median_latency_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rust_projector_rss_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "rust_segment_median_latency_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rust_segment_rss_ratio": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projector", "segment", "crash", "supervisedSoak"],
      "properties": {
        "projector": { "type": "string", "minLength": 1 },
        "segment": { "type": "string", "minLength": 1 },
        "crash": { "type": "string", "minLength": 1 },
        "supervisedSoak": { "type": "string", "minLength": 1 },
        "naturalSoak": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "projector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_ns_per_event", "p95_ns_per_event", "max_rss_bytes"],
      "properties": {
        "median_ns_per_event": { "type": "number", "exclusiveMinimum": 0 },
        "p95_ns_per_event": { "type": "number", "exclusiveMinimum": 0 },
        "max_rss_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "segmentWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_ns_per_frame", "p95_ns_per_frame", "max_rss_bytes"],
      "properties": {
        "median_ns_per_frame": { "type": "number", "exclusiveMinimum": 0 },
        "p95_ns_per_frame": { "type": "number", "exclusiveMinimum": 0 },
        "max_rss_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
