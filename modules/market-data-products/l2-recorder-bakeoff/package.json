{
  "name": "l2-recorder-bakeoff",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "test": "bun test ./src/**/*.test.ts",
    "capture": "bun ./src/scripts/capture.ts",
    "benchmark": "bun ./src/scripts/benchmark.ts",
    "segment-benchmark": "bun ./src/scripts/segment-benchmark.ts",
    "crash-injection": "bun ./src/scripts/crash-injection.ts",
    "soak:rust": "cargo run --release --bin l2-soak-rust --",
    "soak:supervisor": "bun ./src/scripts/soak-supervisor.ts",
    "soak:natural": "bun ./src/scripts/natural-soak-supervisor.ts",
    "soak:natural:launch": "bun ./src/scripts/natural-soak-launch.ts",
    "soak:natural:status": "bun ./src/scripts/natural-soak-status.ts",
    "adoption-input": "bun ./src/scripts/adoption-input.ts",
    "check": "bun run lint && bun run test"
  }
}
