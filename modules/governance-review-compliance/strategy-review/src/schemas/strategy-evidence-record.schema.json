{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-review.strategy-evidence-record.v1",
  "title": "trade-flow strategy evidence record",
  "description": "Stable outer shape for strategy evidence JSONL records. Evidence-specific proof payloads remain intentionally shallow here.",
  "type": "object",
  "required": [
    "evidence_id",
    "created_at",
    "strategy_id",
    "setup_id",
    "kind",
    "policy_hash",
    "source_ref",
    "stats"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "setup_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["replay", "shadow", "live_small", "review_batch"]
    },
    "policy_hash": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "object"
    },
    "replay_context": {
      "type": "object"
    },
    "source_ref": {
      "type": "string"
    },
    "stats": {
      "$ref": "#/$defs/evidence_stats"
    },
    "anti_overfit": {
      "type": "object"
    },
    "robustness": {
      "type": "object"
    },
    "execution_attribution": {
      "type": "object"
    },
    "qualification": {
      "type": "object"
    },
    "gate": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence_stats": {
      "type": "object",
      "required": ["sample_count", "avg_r", "total_r"],
      "properties": {
        "sample_count": {
          "type": "number",
          "minimum": 0
        },
        "win_rate": {
          "type": "number"
        },
        "avg_r": {
          "type": "number"
        },
        "total_r": {
          "type": "number"
        },
        "max_drawdown_r": {
          "type": "number"
        },
        "profit_factor": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}
