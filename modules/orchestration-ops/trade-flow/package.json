{
  "name": "trade-flow",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "launchd:install": "bun src/scripts/program-shadow-launchd.ts install",
    "launchd:status": "bun src/scripts/program-shadow-launchd.ts status",
    "launchd:uninstall": "bun src/scripts/program-shadow-launchd.ts uninstall",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "test": "bun test ./src/scripts/*.test.ts ./src/scripts/**/*.test.ts",
    "check": "bun run lint && bun run test"
  }
}
