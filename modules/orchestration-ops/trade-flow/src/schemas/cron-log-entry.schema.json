{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.cron-log-entry.v1",
  "title": "trade-flow cron log entry",
  "description": "Stable JSONL entry shape for slow/fast cron audit logs.",
  "type": "object",
  "required": [
    "run_id",
    "track",
    "triggered_at",
    "duration_ms",
    "status",
    "chains_processed",
    "actions_taken",
    "errors"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "enum": ["slow", "fast"]
    },
    "triggered_at": {
      "type": "string",
      "minLength": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": ["completed", "skipped_lock", "failed"]
    },
    "chains_processed": {
      "type": "integer",
      "minimum": 0
    },
    "actions_taken": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_cron_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
