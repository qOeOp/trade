{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.runtime-load-result.v1",
  "title": "trade-flow runtime load result",
  "description": "Stable outer shape for loaded runtime policy/config. Account config and strategy internals remain owned by their source files.",
  "type": "object",
  "required": ["trading_config", "runtime_policy", "account_config", "strategies", "loaded_at"],
  "properties": {
    "trading_config": {
      "type": "object"
    },
    "runtime_policy": {
      "type": "object",
      "required": ["schema_version", "profile_id", "mode", "source_hash", "effective_limits", "cost_model", "permissions"],
      "properties": {
        "schema_version": { "const": "runtime-policy.v1" },
        "profile_id": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "source_hash": { "type": "string", "minLength": 1 },
        "compiled_at": { "type": "string", "minLength": 1 },
        "effective_limits": { "type": "object" },
        "cost_model": { "type": "object" },
        "permissions": { "type": "object" },
        "applied_overrides": { "type": "array" },
        "warnings": { "type": "array" }
      },
      "additionalProperties": false
    },
    "account_config": {
      "type": "object"
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "loaded_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
