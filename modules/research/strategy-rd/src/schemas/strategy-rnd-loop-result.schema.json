{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trade-flow.strategy-rnd-loop-result.v1",
  "title": "trade-flow strategy R&D loop result",
  "description": "Stable outer shape for one auditable R&D loop iteration.",
  "type": "object",
  "required": ["run_id", "created_at", "artifact_ref", "ledger_ref", "batch", "ledger_record", "stop_reason"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "ledger_ref": { "type": "string", "minLength": 1 },
    "batch": { "$ref": "../../../candidate-batch/src/schemas/strategy-rnd-batch-result.schema.json" },
    "ledger_record": { "type": "object" },
    "stop_reason": { "enum": ["candidate_found", "no_promote"] },
    "rd_program_state": { "$ref": "../../../rd-program-state/src/schemas/rd-program-state-result.schema.json" }
  },
  "additionalProperties": false
}
