diff --git a/src/agents/agent-bundle-mcp-schema.ts b/src/agents/agent-bundle-mcp-schema.ts
new file mode 100644
index 00000000..3fd83918
--- /dev/null
+++ b/src/agents/agent-bundle-mcp-schema.ts
@@ -0,0 +1,155 @@
+/** Shared JSON Schema compilation for bundle MCP catalogs and terminal results. */
+import { AjvJsonSchemaValidator } from "@modelcontextprotocol/sdk/validation/ajv-provider.js";
+import type {
+  JsonSchemaType,
+  JsonSchemaValidator,
+  jsonSchemaValidator,
+} from "@modelcontextprotocol/sdk/validation/types.js";
+import { Compile } from "typebox/compile";
+import { toErrorObject } from "../infra/errors.js";
+import {
+  findJsonSchemaShapeError,
+  normalizeJsonSchemaForTypeBox,
+} from "../shared/json-schema-defaults.js";
+
+const DRAFT_2020_12_SCHEMA = "https://json-schema.org/draft/2020-12/schema";
+
+function isDraft202012Schema(schema: JsonSchemaType): boolean {
+  return (schema as { $schema?: unknown }).$schema === DRAFT_2020_12_SCHEMA;
+}
+
+function formatTypeBoxErrors(errors: Array<{ instancePath?: string; message?: string }>): string {
+  return (
+    errors
+      .map((error) => {
+        const message = error.message?.trim() || "schema validation failed";
+        return error.instancePath ? `${error.instancePath} ${message}` : message;
+      })
+      .join(", ") || "schema validation failed"
+  );
+}
+
+const schemaMapKeywords = new Set([
+  "$defs",
+  "definitions",
+  "dependentSchemas",
+  "patternProperties",
+  "properties",
+]);
+const schemaValueKeywords = new Set([
+  "additionalItems",
+  "additionalProperties",
+  "contains",
+  "else",
+  "if",
+  "items",
+  "not",
+  "propertyNames",
+  "then",
+  "unevaluatedItems",
+  "unevaluatedProperties",
+]);
+const schemaArrayKeywords = new Set(["allOf", "anyOf", "oneOf", "prefixItems"]);
+
+function stripSchemaMapFormats(value: unknown): unknown {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    return value;
+  }
+  return Object.fromEntries(
+    Object.entries(value).map(([key, entry]) => [key, stripJsonSchemaFormats(entry)]),
+  );
+}
+
+function expandJsonSchemaTypeArray(schema: Record<string, unknown>): Record<string, unknown> {
+  const { type, ...rest } = schema;
+  if (!Array.isArray(type)) {
+    return schema;
+  }
+  return {
+    anyOf: type.map((entry) => Object.assign({}, rest, { type: entry })),
+  };
+}
+
+function stripJsonSchemaFormats(schema: unknown): unknown {
+  if (Array.isArray(schema)) {
+    return schema.map((entry) => stripJsonSchemaFormats(entry));
+  }
+  if (!schema || typeof schema !== "object") {
+    return schema;
+  }
+  const normalizedSchema = expandJsonSchemaTypeArray(schema as Record<string, unknown>);
+  return Object.fromEntries(
+    Object.entries(normalizedSchema)
+      .filter(([key]) => key !== "format")
+      .map(([key, value]) => {
+        if (schemaMapKeywords.has(key)) {
+          return [key, stripSchemaMapFormats(value)];
+        }
+        if (key === "dependencies") {
+          return [key, stripSchemaMapFormats(value)];
+        }
+        if (schemaValueKeywords.has(key) || schemaArrayKeywords.has(key)) {
+          return [key, stripJsonSchemaFormats(value)];
+        }
+        return [key, value];
+      }),
+  );
+}
+
+export function createBundleMcpJsonSchemaValidator(): jsonSchemaValidator {
+  const defaultValidator = new AjvJsonSchemaValidator();
+
+  return {
+    getValidator<T>(schema: JsonSchemaType): JsonSchemaValidator<T> {
+      if (!isDraft202012Schema(schema)) {
+        return defaultValidator.getValidator<T>(schema);
+      }
+      let validator: ReturnType<typeof Compile>;
+      try {
+        const schemaError = findJsonSchemaShapeError(schema as never);
+        if (schemaError) {
+          throw new Error(schemaError);
+        }
+        validator = Compile(
+          normalizeJsonSchemaForTypeBox(stripJsonSchemaFormats(schema) as never) as never,
+        );
+      } catch (error) {
+        const setupError = toErrorObject(error, "schema setup failed");
+        throw new Error(`Invalid MCP draft-2020-12 JSON Schema: ${setupError.message}`, {
+          cause: error,
+        });
+      }
+      return (input: unknown) => {
+        const valid = validator.Check(input);
+        if (valid) {
+          return {
+            valid: true,
+            data: input as T,
+            errorMessage: undefined,
+          };
+        }
+        return {
+          valid: false,
+          data: undefined,
+          errorMessage: formatTypeBoxErrors([...validator.Errors(input)]),
+        };
+      };
+    },
+  };
+}
+
+const outputSchemaValidatorCache = new WeakMap<object, JsonSchemaValidator<unknown>>();
+
+/** Compile once per exact advertised schema object identity. */
+export function getBundleMcpOutputSchemaValidator(
+  schema: JsonSchemaType,
+): JsonSchemaValidator<unknown> {
+  const schemaIdentity = schema as object;
+  const cached = outputSchemaValidatorCache.get(schemaIdentity);
+  if (cached) {
+    return cached;
+  }
+  const validator = createBundleMcpJsonSchemaValidator().getValidator(schema);
+  outputSchemaValidatorCache.set(schemaIdentity, validator);
+  return validator;
+}
diff --git a/src/agents/agent-bundle-mcp-terminal.ts b/src/agents/agent-bundle-mcp-terminal.ts
new file mode 100644
index 00000000..4ef231c0
--- /dev/null
+++ b/src/agents/agent-bundle-mcp-terminal.ts
@@ -0,0 +1,215 @@
+/** Opaque process-local provenance for one exact host-verified MCP terminal result. */
+export type VerifiedMcpTerminalResult = Readonly<{ text: string }>;
+
+export type McpTerminalResultConsumer = (
+  toolCallId: string,
+  result: unknown,
+) => VerifiedMcpTerminalResult | undefined;
+
+/** Opaque process-local identity for one exact configured terminal MCP tool call. */
+export type VerifiedMcpTerminalProgressCall = Readonly<Record<never, never>>;
+
+export type VerifiedMcpTerminalProgress = Readonly<{
+  call: VerifiedMcpTerminalProgressCall;
+  serverName: string;
+  toolName: string;
+  toolCallId: string;
+}>;
+
+const verifiedMcpTerminalResults = new WeakMap<object, VerifiedMcpTerminalResult>();
+const verifiedMcpTerminalRecords = new WeakSet<object>();
+const verifiedMcpTerminalProgressCalls = new WeakMap<
+  object,
+  Omit<VerifiedMcpTerminalProgress, "call">
+>();
+const verifiedMcpTerminalProgressUpdates = new WeakMap<object, object>();
+const verifiedMcpTerminalProgressRecords = new WeakMap<object, VerifiedMcpTerminalProgress>();
+const unconsumedMcpTerminalProgressRecords = new WeakSet<object>();
+
+type PendingMcpTerminalResult = Readonly<{
+  record: VerifiedMcpTerminalResult;
+  serverName: string;
+  toolName: string;
+  structuredContent: unknown;
+}>;
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    return false;
+  }
+  const prototype = Object.getPrototypeOf(value);
+  return prototype === Object.prototype || prototype === null;
+}
+
+function hasExactKeys(record: Record<string, unknown>, expected: readonly string[]): boolean {
+  const actual = Object.keys(record).toSorted();
+  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
+}
+
+function jsonValuesMatch(left: unknown, right: unknown): boolean {
+  try {
+    return JSON.stringify(left) === JSON.stringify(right);
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Creates one run-local, one-shot bridge across AgentSession's tool-result clone.
+ *
+ * The MCP adapter registers only after output-schema, text parity, UTF-8, and byte-bound
+ * validation. The subscriber then consumes the cloned result by the exact tool-call identity and
+ * revalidates every terminal-bearing public field before recovering the opaque verified record.
+ */
+export function createMcpTerminalResultBroker(): {
+  register: (toolCallId: string, result: unknown) => void;
+  consume: McpTerminalResultConsumer;
+  clear: () => void;
+} {
+  const pending = new Map<string, PendingMcpTerminalResult>();
+  return {
+    register: (toolCallId, result) => {
+      const record = readMcpTerminalResult(result);
+      if (!record || !isPlainRecord(result) || pending.has(toolCallId)) {
+        return;
+      }
+      const content = result.content;
+      const details = result.details;
+      if (
+        result.terminate !== true ||
+        !Array.isArray(content) ||
+        content.length !== 1 ||
+        !isPlainRecord(content[0]) ||
+        !hasExactKeys(content[0], ["text", "type"]) ||
+        content[0].type !== "text" ||
+        content[0].text !== record.text ||
+        !isPlainRecord(details) ||
+        !hasExactKeys(details, ["mcpServer", "mcpTool", "structuredContent"]) ||
+        typeof details.mcpServer !== "string" ||
+        typeof details.mcpTool !== "string"
+      ) {
+        return;
+      }
+      pending.set(
+        toolCallId,
+        Object.freeze({
+          record,
+          serverName: details.mcpServer,
+          toolName: details.mcpTool,
+          structuredContent: details.structuredContent,
+        }),
+      );
+    },
+    consume: (toolCallId, result) => {
+      const expected = pending.get(toolCallId);
+      pending.delete(toolCallId);
+      if (!expected || !isPlainRecord(result)) {
+        return undefined;
+      }
+      const content = result.content;
+      const details = result.details;
+      if (
+        !hasExactKeys(result, ["content", "details", "terminate"]) ||
+        result.terminate !== true ||
+        !Array.isArray(content) ||
+        content.length !== 1 ||
+        !isPlainRecord(content[0]) ||
+        !hasExactKeys(content[0], ["text", "type"]) ||
+        content[0].type !== "text" ||
+        content[0].text !== expected.record.text ||
+        !isPlainRecord(details) ||
+        !hasExactKeys(details, ["mcpServer", "mcpTool", "structuredContent"]) ||
+        details.mcpServer !== expected.serverName ||
+        details.mcpTool !== expected.toolName ||
+        !jsonValuesMatch(details.structuredContent, expected.structuredContent)
+      ) {
+        return undefined;
+      }
+      return expected.record;
+    },
+    clear: () => pending.clear(),
+  };
+}
+
+export function markMcpTerminalResult(result: object, text: string): void {
+  const record = Object.freeze({ text });
+  verifiedMcpTerminalRecords.add(record);
+  verifiedMcpTerminalResults.set(result, record);
+}
+
+export function readMcpTerminalResult(result: unknown): VerifiedMcpTerminalResult | undefined {
+  if (!result || typeof result !== "object" || Array.isArray(result)) {
+    return undefined;
+  }
+  return verifiedMcpTerminalResults.get(result);
+}
+
+export function readVerifiedMcpTerminalResult(record: unknown): string | undefined {
+  if (!record || typeof record !== "object" || Array.isArray(record)) {
+    return undefined;
+  }
+  if (!verifiedMcpTerminalRecords.has(record)) {
+    return undefined;
+  }
+  return (record as VerifiedMcpTerminalResult).text;
+}
+
+export function consumeVerifiedMcpTerminalResult(record: unknown): string | undefined {
+  const text = readVerifiedMcpTerminalResult(record);
+  if (text === undefined) {
+    return undefined;
+  }
+  verifiedMcpTerminalRecords.delete(record as object);
+  return text;
+}
+
+export function createMcpTerminalProgressCall(params: {
+  serverName: string;
+  toolName: string;
+  toolCallId: string;
+}): VerifiedMcpTerminalProgressCall {
+  const call = Object.freeze({});
+  verifiedMcpTerminalProgressCalls.set(call, Object.freeze({ ...params }));
+  return call;
+}
+
+export function markMcpTerminalProgressUpdate(
+  update: object,
+  call: VerifiedMcpTerminalProgressCall,
+): void {
+  const identity = verifiedMcpTerminalProgressCalls.get(call);
+  if (!identity) {
+    return;
+  }
+  const record = Object.freeze({ call, ...identity });
+  verifiedMcpTerminalProgressUpdates.set(update, record);
+  verifiedMcpTerminalProgressRecords.set(record, record);
+  unconsumedMcpTerminalProgressRecords.add(record);
+}
+
+export function readMcpTerminalProgressUpdate(update: unknown): object | undefined {
+  if (!update || typeof update !== "object" || Array.isArray(update)) {
+    return undefined;
+  }
+  return verifiedMcpTerminalProgressUpdates.get(update);
+}
+
+export function readVerifiedMcpTerminalProgress(
+  record: unknown,
+): VerifiedMcpTerminalProgress | undefined {
+  if (!record || typeof record !== "object" || Array.isArray(record)) {
+    return undefined;
+  }
+  return verifiedMcpTerminalProgressRecords.get(record);
+}
+
+export function consumeVerifiedMcpTerminalProgress(
+  record: unknown,
+): VerifiedMcpTerminalProgress | undefined {
+  const progress = readVerifiedMcpTerminalProgress(record);
+  if (!progress || !unconsumedMcpTerminalProgressRecords.has(record as object)) {
+    return undefined;
+  }
+  unconsumedMcpTerminalProgressRecords.delete(record as object);
+  return progress;
+}
