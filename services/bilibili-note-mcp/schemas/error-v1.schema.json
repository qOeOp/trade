        "PART_REQUIRED",
        "SOURCE_UNAVAILABLE",
        "ACCESS_DENIED",
        "RATE_LIMITED",
        "SOURCE_CHANGED",
        "TRANSCRIPT_UNAVAILABLE",
        "TRANSCRIPT_INCOMPLETE",
        "HD_SOURCE_UNAVAILABLE",
        "DISTILLATION_FAILED",
        "VISUAL_EVIDENCE_INCOMPLETE",
        "OUTPUT_INVALID",
        "CANCELLED",
        "DEADLINE_EXCEEDED",
        "SEARCH_EMPTY",
        "SEARCH_TARGET_UNMET",
        "INTERNAL"
