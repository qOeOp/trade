{
  "$defs": {
    "AudioReview": {
      "properties": {
        "alternate_text": {
          "title": "Alternate Text",
          "type": "string"
        },
        "differs": {
          "title": "Differs",
          "type": "boolean"
        },
        "end_ms": {
          "title": "End Ms",
          "type": "integer"
        },
        "primary_text": {
          "title": "Primary Text",
          "type": "string"
        },
        "provider_ref": {
          "title": "Provider Ref",
          "type": "string"
        },
        "start_ms": {
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "primary_text",
        "alternate_text",
        "provider_ref",
        "differs"
      ],
      "title": "AudioReview",
      "type": "object"
    },
    "FrameResult": {
      "additionalProperties": false,
      "properties": {
        "asset_ref": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Ref",
          "type": "string"
        },
        "frame_id": {
          "pattern": "^F[0-9]{2}$",
          "title": "Frame Id",
          "type": "string"
        },
        "group_id": {
          "pattern": "^G[0-9]{2}$",
          "title": "Group Id",
          "type": "string"
        },
        "height": {
          "minimum": 720,
          "title": "Height",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "selection_reason": {
          "enum": [
            "deictic_cue",
            "visual_activity",
            "ordered_relation_cue",
            "coverage"
          ],
          "title": "Selection Reason",
          "type": "string"
        },
        "timestamp_ms": {
          "minimum": 0,
          "title": "Timestamp Ms",
          "type": "integer"
        },
        "transcript_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Transcript Refs",
          "type": "array"
        },
        "width": {
          "minimum": 720,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "frame_id",
        "group_id",
        "timestamp_ms",
        "width",
        "height",
        "asset_ref",
        "transcript_refs",
        "selection_reason",
        "path"
      ],
      "title": "FrameResult",
      "type": "object"
    },
    "SourceV1": {
      "additionalProperties": false,
      "properties": {
        "author_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Author Name"
        },
        "canonical_url": {
          "title": "Canonical Url",
          "type": "string"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "maximum": 5760000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "part_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Part Id",
          "type": "string"
        },
        "part_index": {
          "minimum": 1,
          "title": "Part Index",
          "type": "integer"
        },
        "platform": {
          "enum": [
            "bilibili",
            "youtube",
            "generic",
            "local"
          ],
          "title": "Platform",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "requested_url": {
          "title": "Requested Url",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "video_id": {
          "pattern": "^(?:BV[0-9A-Za-z]{10}|[A-Za-z0-9_-]{11}|(?:web|local)-[0-9a-f]{64})$",
          "title": "Video Id",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "requested_url",
        "canonical_url",
        "video_id",
        "part_id",
        "part_index",
        "title",
        "author_name",
        "published_at",
        "duration_ms"
      ],
      "title": "SourceV1",
      "type": "object"
    },
    "TranscriptResult": {
      "properties": {
        "covered_duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covered Duration Ms"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "method": {
          "enum": [
            "platform_subtitle",
            "asr",
            "imported"
          ],
          "title": "Method",
          "type": "string"
        },
        "provider_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Ref"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/TranscriptSegment"
          },
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "method",
        "provider_ref",
        "language",
        "segments"
      ],
      "title": "TranscriptResult",
      "type": "object"
    },
    "TranscriptSegment": {
      "properties": {
        "end_ms": {
          "title": "End Ms",
          "type": "integer"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "start_ms": {
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "start_ms",
        "end_ms",
        "text"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "anyOf": [
        {
          "pattern": "^frames-[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Id"
    },
    "frames": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FrameResult"
      },
      "maxItems": 48,
      "title": "Frames",
      "type": "array"
    },
    "media_id": {
      "anyOf": [
        {
          "pattern": "^media-[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Id"
    },
    "media_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Path"
    },
    "quality": {
      "anyOf": [
        {
          "enum": [
            "fast",
            "standard",
            "precise"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality"
    },
    "reviews": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AudioReview"
      },
      "maxItems": 4096,
      "title": "Reviews",
      "type": "array"
    },
    "schema": {
      "const": "video-note.artifact-result/v1",
      "title": "Schema",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceV1"
    },
    "transcript": {
      "anyOf": [
        {
          "$ref": "#/$defs/TranscriptResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "transcript_id": {
      "anyOf": [
        {
          "pattern": "^transcript-[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Id"
    }
  },
  "required": [
    "schema",
    "source"
  ],
  "title": "ArtifactResultV1",
  "type": "object"
}
