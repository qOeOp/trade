{
  "additionalProperties": false,
  "properties": {
    "media_id": {
      "anyOf": [
        {
          "pattern": "^media-[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Id"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "title": "DownloadInput",
  "type": "object"
}
