{
  "$defs": {
    "GroundedText": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "text": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_refs"
      ],
      "title": "GroundedText",
      "type": "object"
    },
    "NoteChapter": {
      "additionalProperties": false,
      "properties": {
        "points": {
          "items": {
            "$ref": "#/$defs/GroundedText"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "screenshots": {
          "items": {
            "$ref": "#/$defs/ScreenshotSelection"
          },
          "maxItems": 5,
          "title": "Screenshots",
          "type": "array"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "points",
        "screenshots"
      ],
      "title": "NoteChapter",
      "type": "object"
    },
    "ScreenshotSelection": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "pattern": "^F[0-9]{2}$",
          "title": "Frame Id",
          "type": "string"
        }
      },
      "required": [
        "frame_id"
      ],
      "title": "ScreenshotSelection",
      "type": "object"
    },
    "VideoNote": {
      "additionalProperties": false,
      "properties": {
        "chapters": {
          "items": {
            "$ref": "#/$defs/NoteChapter"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Chapters",
          "type": "array"
        },
        "overview": {
          "items": {
            "$ref": "#/$defs/GroundedText"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Overview",
          "type": "array"
        },
        "takeaways": {
          "items": {
            "$ref": "#/$defs/GroundedText"
          },
          "maxItems": 12,
          "title": "Takeaways",
          "type": "array"
        }
      },
      "required": [
        "overview",
        "chapters",
        "takeaways"
      ],
      "title": "VideoNote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "pattern": "^frames-[0-9a-f]{64}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "note": {
      "$ref": "#/$defs/VideoNote"
    }
  },
  "required": [
    "evidence_id",
    "note"
  ],
  "title": "RenderInput",
  "type": "object"
}
