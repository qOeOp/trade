[Unit]
Description=Publish checked Web and Paper control builds without restarting strategies
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# The fixed launcher: the tick runs under the admitted version's own control code (control/current).
ExecStart=/opt/trade-release/trade-release-tick
TimeoutStartSec=75min
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/trade-release
