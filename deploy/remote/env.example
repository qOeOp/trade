# Non-secret deployment values. Do not put OAuth secrets in this file.
# The public host name; the release control reads it and TRADE_DATA from this file too. TRADE_DOMAIN_ALIASES
# (optional) are other names of this host, space-separated, each redirected to TRADE_DOMAIN.
TRADE_DOMAIN_ALIASES=
TRADE_DOMAIN=trade.example.com
# Members of this GitHub team (its slug, in this organization) are allowed in; nobody else is.
TRADE_GITHUB_ORG=replace-with-your-github-organization
TRADE_GITHUB_TEAM=replace-with-the-team-slug
# The public DoltHub repository of your research ledger, which this host mirrors.
TRADE_RESEARCH_ORIGIN=https://doltremoteapi.dolthub.com/replace-with-owner/replace-with-repository
TRADE_GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
TRADE_GITHUB_CLIENT_SECRET_FILE=/srv/trade-private/github-client-secret
TRADE_OAUTH_COOKIE_SECRET_FILE=/srv/trade-private/oauth-cookie-secret
TRADE_UID=1000
TRADE_GID=1000
TRADE_DATA=/srv/trade
DOCKER_SOCK=/var/run/docker.sock
# Cap is a deployment budget, not measured RSS. Validate before choosing a small host.
TRADE_LEDGER_MEMORY=2g
# Paper runs' memory budget, read by each Paper controller the release plane creates; empty means 3584m.
TRADE_PAPER_MEMORY=
# TRADE_IDE_IMAGE, TRADE_SERVICE_IMAGE and TRADE_RUNTIME_IMAGE: python3 -m deploy.images --env <this file>
