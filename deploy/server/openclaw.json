{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    "controlUi": {
      "enabled": false
    },
    "http": {
      "endpoints": {
        "responses": {
          "enabled": true,
          "files": {
            "allowUrl": false
          },
          "images": {
            "allowUrl": false
          }
        },
        "chatCompletions": {
          "enabled": false
        }
      }
    }
  },
  "update": {
    "checkOnStart": false
  },
  "audit": {
    "enabled": true
  },
  "logging": {
    "level": "info",
    "consoleLevel": "info",
    "consoleStyle": "json",
    "redactSensitive": "tools",
    "maxFileBytes": 20971520
  },
  "diagnostics": {
    "enabled": true,
    "stuckSessionWarnMs": 120000,
    "stuckSessionAbortMs": 600000,
    "memoryPressureSnapshot": false,
    "otel": {
      "enabled": false,
      "captureContent": {
        "enabled": false,
        "inputMessages": false,
        "outputMessages": false,
        "toolInputs": false,
        "toolOutputs": false,
        "systemPrompt": false,
        "toolDefinitions": false
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "siliconflow": {
        "baseUrl": "https://api.siliconflow.cn/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "SILICONFLOW_API_KEY"
        },
        "api": "openai-completions",
        "timeoutSeconds": 600,
        "models": [
          {
            "id": "Qwen/Qwen3.5-27B",
            "name": "Qwen3.5 27B via SiliconFlow",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 131072,
            "maxTokens": 32768
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "siliconflow/Qwen/Qwen3.5-27B",
        "fallbacks": []
      },
      "skills": [],
      "timeoutSeconds": 600,
      "thinkingDefault": "high",
      "reasoningDefault": "off",
      "sandbox": {
        "mode": "off"
      },
      "subagents": {
        "maxConcurrent": 1,
        "maxChildrenPerAgent": 1,
        "maxSpawnDepth": 1
      }
    },
    "list": [
      {
        "id": "rd-planner",
        "default": true,
        "workspace": "/home/node/.openclaw/workspaces/rd-planner",
        "skills": [],
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["trade-planner__*"],
          "deny": ["group:runtime", "group:fs", "group:web", "group:sessions", "group:automation", "group:messaging", "group:nodes", "group:agents", "group:media", "group:ui"]
        }
      },
      {
        "id": "rd-reviewer",
        "workspace": "/home/node/.openclaw/workspaces/rd-reviewer",
        "skills": [],
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["trade-reviewer__*"],
          "deny": ["group:runtime", "group:fs", "group:web", "group:sessions", "group:automation", "group:messaging", "group:nodes", "group:agents", "group:media", "group:ui"]
        }
      },
      {
        "id": "ops-explanation",
        "workspace": "/home/node/.openclaw/workspaces/ops-explanation",
        "skills": [],
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["trade-explanation__*"],
          "deny": ["group:runtime", "group:fs", "group:web", "group:sessions", "group:automation", "group:messaging", "group:nodes", "group:agents", "group:media", "group:ui"]
        }
      }
    ]
  },
  "tools": {
    "profile": "minimal",
    "deny": ["browser", "canvas", "cron", "gateway", "sessions_spawn", "subagents", "exec", "process", "code_execution", "read", "write", "edit", "apply_patch"]
  },
  "mcp": {
    "sessionIdleTtlMs": 600000,
    "servers": {
      "trade-planner": {
        "url": "http://agent-mcp-planner:7312/mcp",
        "transport": "streamable-http",
        "connectTimeout": 5,
        "timeout": 120,
        "supportsParallelToolCalls": false,
        "headers": {
          "Authorization": "Bearer ${TRADE_MCP_HTTP_TOKEN}"
        }
      },
      "trade-reviewer": {
        "url": "http://agent-mcp-reviewer:7312/mcp",
        "transport": "streamable-http",
        "connectTimeout": 5,
        "timeout": 120,
        "supportsParallelToolCalls": false,
        "headers": {
          "Authorization": "Bearer ${TRADE_MCP_HTTP_TOKEN}"
        }
      },
      "trade-explanation": {
        "url": "http://agent-mcp-explanation:7312/mcp",
        "transport": "streamable-http",
        "connectTimeout": 5,
        "timeout": 120,
        "supportsParallelToolCalls": false,
        "headers": {
          "Authorization": "Bearer ${TRADE_MCP_HTTP_TOKEN}"
        }
      }
    }
  }
}
