POSTGRES_PASSWORD=replace-with-local-random-value
RD_OWNER_DB_PASSWORD=replace-with-local-random-value
RD_FACT_WRITER_DB_PASSWORD=replace-with-local-random-value
MARKET_DATA_OWNER_DB_PASSWORD=replace-with-local-random-value
MARKET_DATA_READER_DB_PASSWORD=replace-with-local-random-value
REPLAY_POLICY_CATALOG_ADMIN_DB_PASSWORD=replace-with-local-random-value
OPERATOR_AUTHORIZATION_DB_PASSWORD=replace-with-local-random-value
PRODUCT_EDGE_DB_PASSWORD=replace-with-local-random-value
QUALIFICATION_OWNER_DB_PASSWORD=replace-with-local-random-value
BACKTEST_OWNER_DB_PASSWORD=replace-with-local-random-value
EXECUTION_WRITER_DB_PASSWORD=replace-with-local-random-value
PORTFOLIO_WRITER_DB_PASSWORD=replace-with-local-random-value
GOVERNANCE_WRITER_DB_PASSWORD=replace-with-local-random-value
INSTRUMENT_OWNER_DB_PASSWORD=replace-with-local-random-value
RISK_WRITER_DB_PASSWORD=replace-with-local-random-value
SCANNER_WRITER_DB_PASSWORD=replace-with-local-random-value
RD_OWNER_API_TOKEN=replace-with-local-random-value
RD_DASHBOARD_OWNER_READ_API_TOKEN=replace-with-local-random-value
DASHBOARD_LOCAL_OPERATOR_LOGIN_TOKEN=replace-with-at-least-32-random-bytes
DASHBOARD_SESSION_HMAC_KEY=replace-with-a-different-at-least-32-random-bytes
DASHBOARD_MCP_API_TOKEN=
DASHBOARD_MCP_PRINCIPAL_REF=
DASHBOARD_MCP_TOKEN_EXPIRES_AT_EPOCH_SECONDS=
DASHBOARD_MCP_ALLOWED_HOSTNAMES=localhost,127.0.0.1,[::1]
DASHBOARD_MCP_ALLOWED_ORIGIN_HOSTNAMES=localhost,127.0.0.1,[::1]
DASHBOARD_DATABASE_URL=
DASHBOARD_CURSOR_HMAC_KEY=
DASHBOARD_COMPATIBILITY_ENVELOPES_JSON=
DASHBOARD_COMPATIBILITY_ENVELOPES_DIGEST=
DASHBOARD_ARTIFACT_DIGEST=
RD_OWNER_API_ARTIFACT_DIGEST=
DASHBOARD_DEPLOYMENT_CLASS=
DASHBOARD_DISPOSABLE_ARTIFACT_EXECUTION=
DASHBOARD_DISPOSABLE_DEVELOP_COMPOSER_EXECUTION=
DASHBOARD_DISPOSABLE_EXPLORATORY_REPLAY_EXECUTION=
DASHBOARD_DISPOSABLE_SOURCE_RESEARCH_EXECUTION=
DASHBOARD_EFFECT_WORKER_ID=
DASHBOARD_EFFECT_WORKER_TOKEN=
DASHBOARD_EFFECT_WORKER_ARTIFACT_DIGEST=
DASHBOARD_EFFECT_WORKER_INTERVAL_MS=1000
PRODUCT_EDGE_ROUTING_READ_API_URL=
PRODUCT_EDGE_ROUTING_READ_API_TOKEN=
RD_OWNER_DATABASE_URL=replace-with-private-rd-owner-database-url
RD_FACT_WRITER_DATABASE_URL=replace-with-private-rd-fact-writer-database-url
# These two connect as market_data_owner and market_data_reader, not as rd_owner. The database
# initialisation creates market_data_private under rd_owner as a bootstrap owner, and the authority
# custody migration then transfers it to market_data_owner and removes rd_owner's membership. A URL
# still pointing at rd_owner after that migration fails closed as an unavailable Market Data store.
MARKET_DATA_OWNER_DATABASE_URL=replace-with-private-market-data-owner-database-url
MARKET_DATA_RD_ROLE_SET_DATABASE_URL=replace-with-private-market-data-reader-database-url
# Connects as instrument_owner, for Instrument Master economic terms. Read only by an image built with
# the production Replay features (`composer-replay-issuance`); the default image does not read it.
INSTRUMENT_OWNER_DATABASE_URL=replace-with-private-instrument-owner-database-url
# Market Data's own Data Client, named rather than inferred: databento or binance-spot. Leave it
# empty and the PIT intake is absent, so its routes answer 503 rather than minting a snapshot with
# nothing observed. Which venue the rows come from changes what a snapshot means, so a deployment
# states it instead of falling into one.
MARKET_DATA_OBSERVATION_SOURCE=
# databento: a paid provider. The cost ceiling is what one attempt may spend, in USD; zero refuses
# any range the provider charges for.
DATABENTO_API_KEY=
DATABENTO_PUBLISHERS_PATH=
DATABENTO_MAX_PROBE_COST_USD=0
# binance-spot: keyless and free. The mapping says which venue symbol answers for each Owner
# universe member, as comma-separated member=symbol pairs.
BINANCE_PIT_MEMBERS=
BINANCE_PIT_INTERVAL=1m
REPLAY_POLICY_CATALOG_ADMIN_DATABASE_URL=replace-with-private-replay-policy-catalog-admin-database-url
QUALIFICATION_OWNER_DATABASE_URL=replace-with-private-qualification-writer-database-url
OPERATOR_AUTHORIZATION_DATABASE_URL=replace-with-private-issuer-database-url
PRODUCT_EDGE_DATABASE_URL=replace-with-private-product-edge-database-url
PRODUCT_EDGE_DEPLOYMENT_IDENTITY=trade-rd-workbench-local-v1
PRODUCT_EDGE_TRUSTED_ISSUER_IDENTITY=operator-authorization-issuer-local-v1
PRODUCT_EDGE_TRUSTED_ISSUER_KEY_VERSION=local-key-v1
PRODUCT_EDGE_TRUSTED_AUTHORIZATION_AUDIENCE=R_AND_D
PRODUCT_EDGE_BOOTSTRAP_CONFIG=/absolute/path/to/private-product-edge-bootstrap.json
PRODUCT_EDGE_RECOVERY_CONFIG=/absolute/path/to/private-product-edge-recovery.json
REPLAY_POLICY_CATALOG_BOOTSTRAP_CREATE_COMMAND=/absolute/path/to/private-sealed-replay-policy-catalog-create-command.json
REPLAY_POLICY_CATALOG_BOOTSTRAP_ADVANCE_COMMAND=/absolute/path/to/private-sealed-replay-policy-catalog-advance-command.json
REPLAY_POLICY_CATALOG_TRUSTED_VERIFIER_IDENTITY=replay-policy-catalog-bootstrap-verifier-local-v1
REPLAY_POLICY_CATALOG_TRUSTED_VERIFIER_PUBLIC_KEY=/absolute/path/to/private-replay-policy-catalog-verifier-public-key.hex
# Store admission is disabled by default. `required` needs the three identities and every port
# below, and fails closed at startup without any one of them; README gives the procedure.
DEPLOYMENT_STORE_ADMISSION_MODE=disabled
DEPLOYMENT_STORE_ENVIRONMENT_IDENTITY=
DEPLOYMENT_STORE_DEPLOYMENT_IDENTITY=
DEPLOYMENT_STORE_EXPECTED_HEAD_IDENTITY=
# The one anti-rollback mode this single-machine deployment can run, by its exact name:
# SINGLE_TRUST_DOMAIN_NO_ROLLBACK_WITNESS.
DEPLOYMENT_STORE_ANTI_ROLLBACK_MODE=
DEPLOYMENT_STORE_SIGNER_IDENTITY=
# The lease period, in milliseconds, a leased secret file's lease lapses at the end of.
DEPLOYMENT_STORE_LEASE_PERIOD_MS=
# A host directory holding signer-public-key.hex, postgres-root.crt, custodian-connection and
# leased/market-data-admitted-reader, readable by uid 10001. Mounted read-only into rd-owner-api.
DEPLOYMENT_STORE_FILES_DIRECTORY=
# A host directory the administrator's author step reads draft.json from and writes authoring.json
# into, and the publish step reads sealed.json from. It holds no secret.
DEPLOYMENT_STORE_ADMIN_DIRECTORY=
# The server certificate and key the store presents over TLS (server.crt, server.key).
POSTGRES_TLS_DIRECTORY=
STORE_CUSTODY_PUBLISHER_DB_PASSWORD=replace-with-local-random-value
STORE_CUSTODY_CUSTODIAN_DB_PASSWORD=replace-with-local-random-value
# Read only by the administrator's publish step: postgres://deployment_store_publisher:...@postgres:5432/rd_owner
STORE_CUSTODY_PUBLISHER_DATABASE_URL=replace-with-private-publisher-database-url
MARKET_DATA_ADMITTED_READER_DB_PASSWORD=replace-with-local-random-value
RD_WORKBENCH_PORT=18000
DEEPSEEK_API_KEY=
RD_EXECUTION_AGENT_PROVIDER_URL=
RD_EXECUTION_AGENT_MODEL=deepseek-chat
