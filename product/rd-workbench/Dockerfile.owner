# syntax=docker/dockerfile:1.7
FROM public.ecr.aws/docker/library/rust:1.97.1-slim-bookworm@sha256:99e09cb2284e2ddbb73a995deee3e91783fd04d177602ccf6eab326d778ee777 AS builder
WORKDIR /workspace
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY patches ./patches
COPY examples/tutorials ./examples/tutorials
COPY product/rd-workbench/Dockerfile.sandbox ./product/rd-workbench/Dockerfile.sandbox
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/workspace/target,sharing=locked \
    cargo build --locked --release -p vibe-strategy-factory --bin strategy-factory-rd-owner-api \
    && mkdir -p /out \
    && cp target/release/strategy-factory-rd-owner-api /out/

FROM public.ecr.aws/docker/library/rust:1.97.1-slim-bookworm@sha256:99e09cb2284e2ddbb73a995deee3e91783fd04d177602ccf6eab326d778ee777
RUN useradd --create-home --uid 10001 rd-owner
COPY --from=builder /out/strategy-factory-rd-owner-api /usr/local/bin/strategy-factory-rd-owner-api
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/strategy-factory-rd-owner-api"]
